, [8, "JoyNext", 1], [255, "JoyNone", 1]], "binary_blob": "", "custom_title": "", "stable_uid": 300048.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "params": []}, {"anim_alias": "", "x": 1640.0, "helper_text": "", "y": 660.0, "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": true, "end_address": 0.0, "type": "MACRO_CODE", "pc_address": 0.0, "height": 100.0, "title": "CODE BLOCK", "connected": true, "org_parent_x": 1640.0, "org_parent_y": 340.0, "has_org_parent": true, "code": [["code_block", "; Names used in the comments of these blocks (all addresses are written\n; out in the code so nothing here claims memory):\n;   $0400 screen  $8000 GATE_LEVELS map  $A780 LEVEL_GATES  $C100 pulse state\n;   $A800 CLASS  $A900 MASK  $AA00 GTYPE  $AB00 COLOUR  $AC00-$AF2F tables/texts\n;   ZP $50 PS (screen row) $52 PT (state row) $54/$56 row above, $58/$5A row\n;   below, $5C PC (colour row), $5E P1 (general pointer)\n;   $C000 LEVEL $C001 TICK $C002 CHANGED $C003 BLOWN $C004 CUR $C005 NACT\n;   $C006 DELAY $C007 FIREHELD $C008-$C00C REMAIN (AND OR NOT EOR NAND)\n;   $C00E VAL $C00F CM $C010 CK $C011 CH $C012 TMP $C013 FLASH\n;   $C014/$C015 input values $C016/$C017 input wired flags\n;   $C020 action list lo, $C048 hi, $C070 column, $C098 row\n\n; ---------------------------------------------------------------\n; GAME LOOP body: count down the joystick step delay, then move\n; the cursor sprite to the selected action cell and flash it.\n; (FrameTick and the JOYSTICK node run just above this block.)\n; ---------------------------------------------------------------\nLDA $C006\nBEQ GLNoDelay\nDEC $C006\nGLNoDelay:\nLDX $C004\nLDY $C070,X\nLDA $AC32,Y\nSTA $D000\nLDA $AC5A,Y\nSTA $D010\nLDY $C098,X\nLDA $AC82,Y\nSTA $D001\nINC $C013\nLDA $C013\nLSR\nLSR\nAND #$07\nTAX\nLDA $ACB9,X\nSTA $D027\n"]], "binary_blob": "", "custom_title": "", "stable_uid": 300049.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "params": []}, {"anim_alias": "", "x": 1640.0, "helper_text": "", "y": 760.0, "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 0.0, "type": "NORMAL", "pc_address": 0.0, "height": 60.0, "title": "Opcode", "connected": true, "org_parent_x": 1640.0, "org_parent_y": 340.0, "has_org_parent": true, "code": [["jmp_abs", "GameLoop"]], "binary_blob": "", "custom_title": "", "stable_uid": 300050.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "params": []}, {"anim_alias": "", "x": 1640.0, "helper_text": "", "y": 820.0, "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": true, "end_address": 0.0, "type": "MACRO_CODE", "pc_address": 0.0, "height": 100.0, "title": "CODE BLOCK", "connected": true, "org_parent_x": 1640.0, "org_parent_y": 340.0, "has_org_parent": true, "code": [["code_block", "; Names used in the comments of these blocks (all addresses are written\n; out in the code so nothing here claims memory):\n;   $0400 screen  $8000 GATE_LEVELS map  $A780 LEVEL_GATES  $C100 pulse state\n;   $A800 CLASS  $A900 MASK  $AA00 GTYPE  $AB00 COLOUR  $AC00-$AF2F tables/texts\n;   ZP $50 PS (screen row) $52 PT (state row) $54/$56 row above, $58/$5A row\n;   below, $5C PC (colour row), $5E P1 (general pointer)\n;   $C000 LEVEL $C001 TICK $C002 CHANGED $C003 BLOWN $C004 CUR $C005 NACT\n;   $C006 DELAY $C007 FIREHELD $C008-$C00C REMAIN (AND OR NOT EOR NAND)\n;   $C00E VAL $C00F CM $C010 CK $C011 CH $C012 TMP $C013 FLASH\n;   $C014/$C015 input values $C016/$C017 input wired flags\n;   $C020 action list lo, $C048 hi, $C070 column, $C098 row\n\n; ---------------------------------------------------------------\n; JOYSTICK HANDLERS (called by the JOYSTICK node, end in RTS)\n; UP/LEFT = previous action cell, DOWN/RIGHT = next, FIRE = act.\n; Holding a direction steps again every 8 frames; fire needs a release.\n; ---------------------------------------------------------------\nJoyPrev:\nLDA $C006\nBNE JPDone\nLDA #$08\nSTA $C006\nDEC $C004\nBPL JPMove\nLDX $C005\nDEX\nSTX $C004\nJPMove:\nJSR SndMove\nJPDone:\nRTS\n\nJoyNext:\nLDA $C006\nBNE JNDone\nLDA #$08\nSTA $C006\nINC $C004\nLDA $C004\nCMP $C005\nBCC JNMove\nLDA #$00\nSTA $C004\nJNMove:\nJSR SndMove\nJNDone:\nRTS\n\nJoyNone:\nLDA #$00\nSTA $C007\nSTA $C006\nRTS\n\nJoyFire:\nLDA $C007\nBNE JFDone\nLDA #$01\nSTA $C007\nJMP Act\nJFDone:\nRTS\n\n; ---------------------------------------------------------------\n; Act: fire on the cell under the cursor.\n;   RUN button -> run the circuit (only when every gate is placed)\n;   switch     -> flip between left and right\n;   gate slot  -> next gate type still in stock, then back to empty\n; ---------------------------------------------------------------\nAct:\nLDX $C004\nLDA $C020,X\nSTA $5E\nLDA $C048,X\nSTA $5F\nLDY #$00\nLDA ($5E),Y\nCMP #105\nBNE ActNotRun\nJMP TryRun\nActNotRun:\nCMP #97\nBNE ActNotL\nLDA #98\nJMP ActSwitch\nActNotL:\nCMP #98\nBNE ActSlot\nLDA #97\nActSwitch:\nSTA ($5E),Y\nJSR SndClick\nRTS\n\nActSlot:\n; A = 86 (empty) or 87-91 (placed gate). Put a placed gate back first.\nCMP #86\nBEQ ActFromEmpty\nSEC\nSBC #87\nTAX\nINC $C008,X           ; gate goes back in stock\nINX\nJMP ActSearch\nActFromEmpty:\nLDX #$00\nActSearch:\nCPX #$05\nBCS ActEmpty           ; nothing left after this type -> empty slot\nLDA $C008,X\nBNE ActPlace\nINX\nJMP ActSearch\nActPlace:\nDEC $C008,X\nTXA\nCLC\nADC #87\nJMP ActStore\nActEmpty:\nLDA #86\nActStore:\n; A = new centre char (86 empty, 87-91 gates). Write the 3-cell label:\n; left side = 110+2k, centre, right side = 111+2k (k = char-86).\nSTA $C011\nSEC\nSBC #86\nASL\nCLC\nADC #110\nSTA $C012                ; left side char\nLDA $5E                 ; P1 -> the left cell\nBNE ActDecP\nDEC $5F\nActDecP:\nDEC $5E\nLDY #$00\nLDA $C012\nSTA ($5E),Y\nINY\nLDA $C011\nSTA ($5E),Y\nINY\nLDX $C012\nINX\nTXA\nSTA ($5E),Y             ; right side char\nLDA $5F               ; same three cells in colour RAM\nCLC\nADC #$D4               ; screen page + $D4 = colour page\nSTA $5F\nLDY #$02\nActCol:\nLDX $C012\nCPY #$01\nBNE ActColSide\nLDX $C011\nActColSide:\nLDA $AB00,X\nSTA ($5E),Y\nDEY\nBPL ActCol\nJSR DrawInv\nJSR SndPlace\nRTS\n\n; TryRun: refuse while gates are still in stock.\nTryRun:\nLDX #$04\nTRCheck:\nLDA $C008,X\nBNE TRNotYet\nDEX\nBPL TRCheck\nJMP RunCircuit\nTRNotYet:\nLDA #$01\nJSR ShowMsg            ; \"PLACE ALL GATES...\"\nJSR SndFail\nRTS\n"]], "binary_blob": "", "custom_title": "", "stable_uid": 300051.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "params": []}, {"anim_alias": "", "x": 1960.0, "helper_text": "", "y": 160.0, "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 0.0, "type": "COMMENT", "pc_address": 0.0, "height": 100.0, "title": "COMMENT", "connected": false, "org_parent_x": -1.0, "org_parent_y": -1.0, "has_org_parent": false, "code": [["Comment", "Pulses spread one cell\nper step through wires\nand gates."]], "binary_blob": "", "custom_title": "", "stable_uid": 300052.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "params": []}, {"anim_alias": "", "x": 1960.0, "helper_text": "", "y": 340.0, "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": false, "collapsed": false, "end_address": 0.0, "type": "ORG", "pc_address": 27904.0, "height": 80.0, "title": "ORG BLOCK", "connected": false, "org_parent_x": -1.0, "org_parent_y": -1.0, "has_org_parent": false, "code": [["org", 0.0]], "binary_blob": "", "custom_title": "", "stable_uid": 300053.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": 5.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "params": []}, {"anim_alias": "", "x": 1960.0, "helper_text": "", "y": 420.0, "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": true, "end_address": 0.0, "type": "MACRO_CODE", "pc_address": 0.0, "height": 100.0, "title": "CODE BLOCK", "connected": true, "org_parent_x": 1960.0, "org_parent_y": 340.0, "has_org_parent": true, "code": [["code_block", "; Names used in the comments of these blocks (all addresses are written\n; out in the code so nothing here claims memory):\n;   $0400 screen  $8000 GATE_LEVELS map  $A780 LEVEL_GATES  $C100 pulse state\n;   $A800 CLASS  $A900 MASK  $AA00 GTYPE  $AB00 COLOUR  $AC00-$AF2F tables/texts\n;   ZP $50 PS (screen row) $52 PT (state row) $54/$56 row above, $58/$5A row\n;   below, $5C PC (colour row), $5E P1 (general pointer)\n;   $C000 LEVEL $C001 TICK $C002 CHANGED $C003 BLOWN $C004 CUR $C005 NACT\n;   $C006 DELAY $C007 FIREHELD $C008-$C00C REMAIN (AND OR NOT EOR NAND)\n;   $C00E VAL $C00F CM $C010 CK $C011 CH $C012 TMP $C013 FLASH\n;   $C014/$C015 input values $C016/$C017 input wired flags\n;   $C020 action list lo, $C048 hi, $C070 column, $C098 row\n\n; ---------------------------------------------------------------\n; PULSE SIMULATION\n; Every step looks at each cell that has no value yet:\n;   wire / lamp / fuse: takes the value of a connected neighbour that\n;     already had one before this step (its side must face this cell)\n;   gate: fires once its inputs (left and right wires) both have values;\n;     NOT uses whichever single input is wired.\n; A cell's state is (step*2)|value, so \"had a value before this step\"\n; is state<>0 and state/2 < TICK.  One step per 2 frames shows the\n; pulses travelling up the board.\n; ---------------------------------------------------------------\nRunCircuit:\nJSR ResetBoard\nLDA #$02\nJSR ShowMsg            ; \"PULSE RUNNING...\"\nLDA #$00\nSTA $D015              ; hide the cursor while it runs\nLDA #$02\nSTA $C001\nRCStep:\nLDA #$00\nSTA $C002\nJSR SimStep\nLDA $C002\nBEQ RCQuiet\nJSR SndTick            ; soft tick while pulses move\nRCQuiet:\nJSR FrameTick\nJSR FrameTick\nLDA $C002\nBEQ RCDone\nINC $C001\nLDA $C001\nCMP #120\nBCC RCStep\nRCDone:\nLDA #$01\nSTA $D015\nJMP Judge\n\n; ResetBoard: idle colours back, pulse state cleared, sources primed\n; as step 1 (state 3 = value 1, state 2 = value 0).\nResetBoard:\nLDA #$00\nSTA $C003\nLDA #$02\nSTA $C00D\nRBRow:\nJSR SetRowPtrs\nLDY #$00\nRBCol:\nLDA ($50),Y\nCMP #129               ; a pulse ball left on the board -> its trace\nBCC RBChar\nCMP #144\nBCS RBChar\nSBC #63                ; carry clear: ball -> wire\nSTA ($50),Y\nRBChar:\nTAX\nLDA $AB00,X\nSTA ($5C),Y\nLDA $A800,X\nCMP #$02\nBNE RBNot1\nLDA #$03\nJMP RBSet\nRBNot1:\nCMP #$03\nBNE RBNone\nLDA #$02\nJMP RBSet\nRBNone:\nLDA #$00\nRBSet:\nSTA ($52),Y\nINY\nCPY #40\nBNE RBCol\nINC $C00D\nLDA $C00D\nCMP #25\nBNE RBRow\nRTS\n\n; SeedSources: same as ResetBoard (used after a level is drawn).\nSeedSources:\nJMP ResetBoard\n\n; KnownBefore: A = a neighbour's state. Carry set + VAL = its value\n; when it had one before this step.\nKnownBefore:\nSTA $C012\nBEQ KBNo\nLSR\nCMP $C001\nBCS KBNo\nLDA $C012\nAND #$01\nSTA $C00E\nSEC\nRTS\nKBNo:\nCLC\nRTS\n\nSimStep:\nLDA #$02\nSTA $C00D\nSSRow:\nJSR SetRowPtrs\nLDY #$00\nSSCol:\nLDA ($52),Y\nBEQ SSOpen\n; already has a value: a pulse ball (chars 129-143) from an earlier step\n; turns back into its trace, coloured with the value it carries\nLDA ($50),Y\nCMP #129\nBCC SSNext\nCMP #144\nBCS SSNext\nSBC #63                ; carry clear here: 129-1-63 = 65 (ball -> wire)\nSTA ($50),Y\nLDA ($52),Y\nAND #$01\nBEQ SSBall0\nLDA #$0D\nJMP SSBallC\nSSBall0:\nLDA #$0B\nSSBallC:\nSTA ($5C),Y\nJMP SSNext\nSSOpen:\nLDA ($50),Y\nSTA $C011\nTAX\nLDA $A800,X\nSTA $C010\nCMP #$06\nBNE SSNotGate\nJMP GateCell\nSSNotGate:\nCMP #$01\nBEQ WireCell\nCMP #$04\nBEQ WireCell\nCMP #$05\nBEQ WireCell\nCMP #$08\nBEQ WireCell\nSSNext:\nINY\nCPY #40\nBNE SSCol\nINC $C00D\nLDA $C00D\nCMP #25\nBNE SSRow\nRTS\n\n; ---- wire, lamp or fuse cell ----\nWireCell:\nLDA $A900,X\nSTA $C00F\nAND #$01               ; joined upward?\nBEQ WCDown\nLDA ($54),Y\nTAX\nLDA $A900,X\nAND #$02               ; ...and the cell above joins down\nBEQ WCDown\nLDA ($56),Y\nJSR KnownBefore\nBCS WCSet\nWCDown:\nLDA $C00F\nAND #$02\nBEQ WCLeft\nLDA ($58),Y\nTAX\nLDA $A900,X\nAND #$01\nBEQ WCLeft\nLDA ($5A),Y\nJSR KnownBefore\nBCS WCSet\nWCLeft:\nLDA $C00F\nAND #$04\nBEQ WCRight\nDEY\nLDA ($50),Y\nTAX\nLDA $A900,X\nAND #$08\nBEQ WCLeftN\nLDA ($52),Y\nJSR KnownBefore\nINY\nBCS WCSet\nJMP WCRight\nWCLeftN:\nINY\nWCRight:\nLDA $C00F\nAND #$08\nBEQ WCNone\nINY\nLDA ($50),Y\nTAX\nLDA $A900,X\nAND #$04\nBEQ WCRightN\nLDA ($52),Y\nJSR KnownBefore\nDEY\nBCS WCSet\nJMP WCNone\nWCRightN:\nDEY\nWCNone:\nJMP SSNext\n\nWCSet:\nJSR StoreVal           ; state + \"changed\"\nLDA $C010\nCMP #$08\nBEQ WCFuse\nCMP #$04\nBCS WCLamp             ; 4 or 5\nLDA $C011                 ; plain wire piece (65-79)? show the pulse ball\nCMP #65\nBCC WCPlain\nCMP #80\nBCS WCPlain\nADC #64                ; carry clear: wire -> ball char (129-143)\nSTA ($50),Y\nLDA #$01               ; white ball\nJMP WCCol\nWCPlain:\nLDA $C00E                ; switch: light green = 1, dark grey = 0\nBEQ WCZero\nLDA #$0D\nJMP WCCol\nWCZero:\nLDA #$0B\nWCCol:\nSTA ($5C),Y\nJMP SSNext\nWCLamp:\n; lamp 4 wants 1, lamp 5 wants 0: white when right, red when wrong\nSEC\nSBC #$04               ; 0 = wants 1, 1 = wants 0\nEOR $C00E                ; 1 when right\nBEQ WCLampBad\nLDA #$01\nJMP WCCol\nWCLampBad:\nLDA #$02\nJMP WCCol\nWCFuse:\nLDA $C00E\nBEQ WCZero\nLDA #$01\nSTA $C003\nLDA #$02\nJMP WCCol\n\nStoreVal:\nLDA $C001\nASL\nORA $C00E\nSTA ($52),Y\nLDA #$01\nSTA $C002\nRTS\n\n; ---- gate cell (centre of a 3-cell [AND] label): inputs are the wires\n; two cells to its left and right ----\nGateCell:\nLDA $AA00,X\nSTA $C00F                 ; CM = gate type here\nLDA #$00\nSTA $C016\nSTA $C017\nDEY                    ; left input (2 cells left, past the \"[\" side char)\nDE