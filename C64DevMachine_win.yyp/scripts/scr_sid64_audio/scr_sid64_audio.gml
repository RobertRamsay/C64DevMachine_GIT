/// Import the recovered source format into a complete, self-contained project.
/// Pointer/layout changes are rejected before the current workspace is touched.
function scr_native_tables_import(_source) {
    if (_source.source_sha256 != "455471ecd416fd25dce8fa26c6d74c08ba0497537244b980dbd93268364842de") throw {message: "Different Wizball source version"};
    var _project = scr_native_tables_template();
    var _entry = _project.assets[0];
    var _buf = scr_blob_decode(_entry.blob);
    try {
        var _starts = [0x6043, 0x61C9, 0x62D8];
        if (array_length(_source.voices) != 3) throw {message: "Expected three voices"};
        for (var _v=0; _v<3; _v++) if (_source.voices[_v].start_address != _starts[_v]) throw {message: "Voice layout changed"};
        var _groups = _entry.meta.native_tables.groups;
        var _written = {};
        for (var _g=0; _g<array_length(_groups); _g++) {
            var _records = _groups[_g].records;
            var _source_records = _source[$ _records[0].path[0]];
            if (array_length(_source_records) != array_length(_records)) throw {message: "Table record count changed"};
            for (var _r=0; _r<array_length(_records); _r++) {
                var _rec = _records[_r];
                if (_source_records[_r].address != _rec.address) throw {message: "Table address changed"};
                if (_rec.command != "" && _source_records[_r].command != _rec.command) throw {message: "Song command layout changed"};
                for (var _f=0; _f<array_length(_rec.fields); _f++) {
                    var _field = _rec.fields[_f];
                    var _value = _source;
                    for (var _k=0; _k<array_length(_field.path); _k++) {
                        var _key = _field.path[_k];
                        _value = is_string(_key) ? _value[$ _key] : _value[_key];
                    }
                    if (_field.locked) {
                        if (_value != _field.initial) throw {message: "A fixed table link or mode was changed"};
                        continue;
                    }
                    if (!is_real(_value) || floor(_value) != _value || _value < _field.minimum || _value > _field.maximum) throw {message: "Invalid table value: " + _field.label};
                    for (var _b=0; _b<_field.width; _b++) {
                        var _at = _field.offset+_b;
                        var _byte = (_value >> (_b*8)) & 255;
                        var _slot = string(_at);
                        if (variable_struct_exists(_written, _slot) && _written[$ _slot] != _byte) throw {message: "Conflicting overlapping table edits"};
                        _written[$ _slot] = _byte;
                        buffer_poke(_buf, _at, buffer_u8, _byte);
                    }
                }
            }
        }
        _entry.blob = scr_blob_encode(_buf);
    } catch (_err) {
        buffer_delete(_buf);
        throw _err;
    }
    buffer_delete(_buf);
    return _project;
}

function scr_native_tables_read(_asset, _field) {
    var _n = buffer_peek(_asset.buffer, _field.offset, buffer_u8);
    if (_field.width == 2) _n |= buffer_peek(_asset.buffer, _field.offset+1, buffer_u8) << 8;
    if (_field.signed && _n >= 32768) _n -= 65536;
    return _n;
}

function scr_native_tables_write(_asset, _field, _n) {
    if (_field.locked || !is_real(_n) || floor(_n) != _n || _n < _field.minimum || _n > _field.maximum) return false;
    if (_field.offset < 126 || _field.offset+_field.width > buffer_get_size(_asset.buffer)) return false;
    var _old = scr_native_tables_read(_asset, _field);
    if (_old == _n) return true;
    scr_sid_asset_stop();
    array_push(_asset.native_ui.undo, {field:_field, value:_old});
    for (var _b=0; _b<_field.width; _b++) buffer_poke(_asset.buffer, _field.offset+_b, buffer_u8, (_n >> (_b*8)) & 255);
    global.autosave_dirty = true;
    _asset.native_ui.message = "Changed. Press PLAY to hear from the beginning; save the project to keep edits.";
    return true;
}

/// Native engine uses CIA timer A, not a 50 Hz raster interrupt.
/// RAM IRQ/NMI vectors avoid KERNAL routines using the player's zero page.
function scr_native_tables_player(_asset) {
    var _init = _asset.meta.sid_init_addr;
    var _play = _asset.meta.sid_play_addr;
    return [
        ["sei",0], ["lda_imm",0x7F], ["sta_abs",0xDC0D], ["sta_abs",0xDD0D],
        ["lda_imm",0], ["sta_abs",0xD01A], ["sta_abs",0xDC0E],
        ["lda_abs",0xDC0D], ["lda_abs",0xDD0D],
        ["lda_imm",0x35], ["sta_zp",1], ["lda_imm",0], ["ldx_imm",0], ["ldy_imm",0], ["jsr",_init],
        ["lda_imm",0], ["sta_abs",0xDC0E],
        ["lda_lab_lo","native_sid_irq"], ["sta_abs",0xFFFE],
        ["lda_lab_hi","native_sid_irq"], ["sta_abs",0xFFFF],
        ["lda_lab_lo","native_sid_nmi"], ["sta_abs",0xFFFA],
        ["lda_lab_hi","native_sid_nmi"], ["sta_abs",0xFFFB],
        ["lda_abs",0xDC0D], ["lda_imm",0x81], ["sta_abs",0xDC0D],
        ["lda_imm",0x11], ["sta_abs",0xDC0E], ["cli",0],
        ["label","native_sid_idle"], ["jmp","native_sid_idle"],
        ["label","native_sid_irq"], ["pha",0], ["txa",0], ["pha",0], ["tya",0], ["pha",0],
        ["lda_abs",0xDC0D], ["jsr",_play],
        ["pla",0], ["tay",0], ["pla",0], ["tax",0], ["pla",0], ["rti",0],
        ["label","native_sid_nmi"], ["rti",0]
    ];
}

/// Two independently scrollable lists. Dragging the right track moves its thumb.
function scr_native_tables_scroll(_ui, _key, _count, _rows, _x, _y, _w, _h, _mx, _my) {
    var _max = max(0, _count-_rows);
    if (point_in_rectangle(_mx,_my,_x,_y,_x+_w,_y+_h))
        _ui[$ _key] = clamp(_ui[$ _key] + (mouse_wheel_down()-mouse_wheel_up())*3, 0, _max);
    var _thumb = max(22, _h * min(1, _rows/max(1,_count)));
    var _top = _y + (_h-_thumb) * (_max == 0 ? 0 : _ui[$ _key]/_max);
    if (!global.any_picker_open && mouse_check_button_pressed(mb_left) && point_in_rectangle(_mx,_my,_x+_w-14,_y,_x+_w,_y+_h)) {
        _ui.drag = _key;
        _ui.drag_offset = point_in_rectangle(_mx,_my,_x+_w-14,_top,_x+_w,_top+_thumb) ? _my-_top : _thumb/2;
    }
    if (_ui.drag == _key) {
        if (!mouse_check_button(mb_left)) _ui.drag = "";
        else _ui[$ _key] = clamp(round((_my-_y-_ui.drag_offset)/max(1,_h-_thumb)*_max),0,_max);
    }
    _ui[$ _key] = clamp(_ui[$ _key], 0, _max);
    _top = _y + (_h-_thumb)*(_max == 0 ? 0 : _ui[$ _key]/_max);
    draw_set_color(make_color_rgb(30,34,48)); draw_rectangle(_x+_w-12,_y,_x+_w,_y+_h,false);
    draw_set_color(_ui.drag == _key ? c_aqua : make_color_rgb(100,120,140));
    draw_rectangle(_x+_w-11,_top,_x+_w-1,_top+_thumb,false);
}

function scr_native_tables_editor(_asset,_x,_y,_right,_bottom) {
    if (!variable_struct_exists(_asset,"native_ui")) _asset.native_ui = {group:0,record:0,left_scroll:0,right_scroll:0,edit:-1,drag:"",drag_offset:0,undo:[],message:""};
    var _ui = _asset.native_ui;
    var _mx = global.gui_mouse_x, _my = global.gui_mouse_y;
    var _w = _right-_x;
    draw_set_font_l(fnt_c64_tiny);
    scr_sid_asset_controls(_asset,_x,_y,_w);
    if (scr_native_tables_button(_x+240,_y+20,100,"EXPORT SID",_mx,_my)) {
        var _path = get_save_filename("SID music (*.sid)|*.sid","Wizball_4_edited.sid");
        if (_path != "") { buffer_save(_asset.buffer,_path); _ui.message="SID exported with the current table edits."; }
    }
    if (scr_native_tables_button(_x+350,_y+20,64,"UNDO",_mx,_my) && array_length(_ui.undo)>0) {
        scr_sid_asset_stop();
        var _u=array_pop(_ui.undo);
        for (var _b=0; _b<_u.field.width; _b++) buffer_poke(_asset.buffer,_u.field.offset+_b,buffer_u8,(_u.value >> (8*_b)) & 255);
        global.autosave_dirty=true; _ui.edit=-1; global.is_any_text_active=false;
        _ui.message="Last table edit undone.";
    }
    draw_set_color(c_aqua);
    draw_text_l(_x,_y+78,"NATIVE TABLES  |  5,214 bytes  |  original CIA timing");
    var _groups = _asset.meta.native_tables.groups;
    var _tabw = min(116,floor(_w/5));
    for (var _g=0; _g<array_length(_groups); _g++) {
        if (scr_native_tables_button(_x+_g*_tabw,_y+100,_tabw-4,(_ui.group==_g ? ">" : "")+_groups[_g].title,_mx,_my)) {
            _ui.group=_g; _ui.record=0; _ui.left_scroll=0; _ui.right_scroll=0; _ui.edit=-1; global.is_any_text_active=false;
        }
    }
    var _top=_y+140, _height=max(24,_bottom-_top-74), _rows=max(1,floor(_height/28));
    _height=_rows*28;
    var _leftw=min(320,floor(_w*0.42)), _rx=_x+_leftw+16, _rw=_right-_rx;
    var _records=_groups[_ui.group].records;
    _ui.record=clamp(_ui.record,0,array_length(_records)-1);
    var _rec=_records[_ui.record];
    scr_native_tables_scroll(_ui,"left_scroll",array_length(_records),_rows,_x,_top,_leftw,_height,_mx,_my);
    scr_native_tables_scroll(_ui,"right_scroll",array_length(_rec.fields),_rows,_rx,_top,_rw,_height,_mx,_my);
    for (var _i=0; _i<_rows; _i++) {
        var _ri=_ui.left_scroll+_i; if (_ri>=array_length(_records)) break;
        var _row=_records[_ri], _yy=_top+_i*28;
        var _hover=point_in_rectangle(_mx,_my,_x,_yy,_x+_leftw-16,_yy+23);
        draw_set_color(_ui.record==_ri ? make_color_rgb(55,62,90) : (_hover ? make_color_rgb(38,45,62) : make_color_rgb(22,25,36)));
        draw_rectangle(_x,_yy,_x+_leftw-16,_yy+23,false);
        draw_set_color(_ui.record==_ri ? c_yellow : c_white);
        var _text=string(_ri)+" "+_row.label;
        while (string_width_l(_text)>_leftw-26 && string_length(_text)>1) _text=string_delete(_text,string_length(_text),1);
        draw_text_l(_x+4,_yy+6,_text);
        if (_hover && mouse_check_button_pressed(mb_left) && !global.any_picker_open) {
            _ui.record=_ri; _ui.right_scroll=0; _ui.edit=-1; global.is_any_text_active=false; mouse_clear(mb_left);
        }
    }
    // Re-resolve after a record click so a field from the preceding record cannot be edited.
    _rec=_records[_ui.record];
    for (var _i=0; _i<_rows; _i++) {
        var _fi=_ui.right_scroll+_i; if (_fi>=array_length(_rec.fields)) break;
        var _f=_rec.fields[_fi], _yy=_top+_i*28, _n=scr_native_tables_read(_asset,_f);
        var _valuex=_right-132;
        draw_set_color(_i mod 2 ? make_color_rgb(22,25,36) : make_color_rgb(28,31,43));
        draw_rectangle(_rx,_yy,_right-16,_yy+23,false);
        draw_set_color(_f.locked ? c_gray : c_white);
        var _label=_f.label;
        while (string_width_l(_label)>max(8,_valuex-_rx-34) && string_length(_label)>1) _label=string_delete(_label,string_length(_label),1);
        draw_text_l(_rx+4,_yy+6,_label);
        if (!_f.locked) {
            if (scr_native_tables_button(_valuex-28,_yy,24,"-",_mx,_my)) scr_native_tables_write(_asset,_f,max(_f.minimum,_n-1));
            if (scr_native_tables_button(_right-43,_yy,24,"+",_mx,_my)) scr_native_tables_write(_asset,_f,min(_f.maximum,_n+1));
        }
        var _hover=point_in_rectangle(_mx,_my,_valuex,_yy,_right-48,_yy+23);
        draw_set_color(_ui.edit==_fi ? c_yellow : (_hover && !_f.locked ? c_aqua : (_f.locked ? c_gray : c_white)));
        draw_text_l(_valuex+2,_yy+6,_ui.edit==_fi ? keyboard_string+"_" : string(_n));
        if (_hover && !_f.locked && mouse_check_button_pressed(mb_left) && !global.any_picker_open) {
            _ui.edit=_fi; keyboard_string=""; global.is_any_text_active=true; mouse_clear(mb_left);
        }
    }
    if (_ui.edit>=0 && _ui.edit<array_length(_rec.fields)) {
        global.is_any_text_active=true;
        if (keyboard_check_pressed(vk_escape)) { _ui.edit=-1; global.is_any_text_active=false; keyboard_clear(vk_escape); }
        else if (keyboard_check_pressed(vk_enter)) {
            var _s=string_trim(keyboard_string), _digits=string_replace_all(_s,"-","");
            var _valid=string_length(_digits)>0 && string_digits(_digits)==_digits && (string_pos("-",_s)==0 || (string_pos("-",_s)==1 && string_count("-",_s)==1));
            if (_valid && scr_native_tables_write(_asset,_rec.fields[_ui.edit],real(_s))) { _ui.edit=-1; global.is_any_text_active=false; }
            else _ui.message="Enter a whole number within the field's range.";
            keyboard_clear(vk_enter);
        }
    }
    draw_set_color(c_ltgray);
    draw_text_ext_l(_x,_top+_height+8,"Click a value to type; Enter accepts, Esc cancels. Grey links and modes preserve the original layout.\nDuration values use the original player ticks; song note codes retain their original duration flag.",14,_w);
    draw_set_color(c_aqua); draw_text_ext_l(_x,_top+_height+42,_ui.message,14,_w);
}

function scr_native_tables_button(_x,_y,_w,_text,_mx,_my) {
    var _hot=point_in_rectangle(_mx,_my,_x,_y,_x+_w,_y+23);
    draw_set_color(_hot ? make_color_rgb(65,80,100) : make_color_rgb(30,38,52));
    draw_rectangle(_x,_y,_x+_w,_y+23,false);
    draw_set_color(c_white); draw_text_l(_x+4,_y+5,_text);
    var _pressed=_hot && !global.any_picker_open && mouse_check_button_pressed(mb_left);
    if (_pressed) mouse_clear(mb_left);
    return _pressed;
}
