/// WORKFLOW tour steps for: SPRITE_SET, SPRITE_MASK, ANIMATION, CHAR_SET
/// (see scr_panel_help_workflow for the format)
function scr_panel_help_wf_sprites() {
    return {
        SPRITE_SET : [
            { title: "A BANK OF SPRITES", text: "A sprite set is a bank of up to 64 C64 sprites, each 24x21 pixels and 64 bytes.\n\nA hires sprite has one colour of its own. A multicolour sprite is 12x21 double-wide pixels in three colours: its own plus two shared by all sprites.", targets: [] },
            { title: "BRING SPRITES IN", text: "IMPORT loads SPRED64 text (.txt), .spr, SpritePad .spd or raw .bin files, replacing this set. A raw binary has no colours, so defaults are used until you pick your own.\n\nIMPORT PNG reads a picture as a grid of 24x21 frames and shows a confirm panel before anything changes.", targets: ["IMPORT", "IMPORT PNG"] },
            { title: "OR START FROM SCRATCH", text: "This panel shows every sprite in the set. Click the + cell to add a blank sprite, or click any sprite to open the editor on it.", targets: ["+"] },
            { title: "OPEN THE SPRITE EDITOR", text: "EDIT SPRITES opens the built-in editor. You work on a copy: the same button becomes CLOSE (COMMIT EDITS), which writes everything back to the asset.\n\nOn the left is the slot picker - click a slot to edit it, SHIFT or CTRL + click to select several, CTRL+C / CTRL+V to copy and paste.", targets: ["EDIT SPRITES"] },
            { title: "MODE AND COLOURS", text: "The mode button switches a sprite between hires and multicolour (ALL -> MC / ALL -> HR does the whole bank).\n\nAbove the palette, pick what to paint with: UC is this sprite's own colour, MC1 and MC2 are shared by every multicolour sprite, BG sits behind them all. Then click a palette colour to set it.", targets: ["@PALETTE"] },
            { title: "PAINT THE SPRITE", text: "On the canvas, left drag paints and right drag erases. Middle drag or SPACE + drag shifts the sprite, wrapping at the edges. CTRL+Z undoes.\n\nThe tool row has FLIPX, FLIPY, ROT90, CLEAR, plus FILL and LINE for flood fills and straight lines.", targets: [] },
            { title: "BUILD BIGGER OBJECTS", text: "Below the canvas is the compositor. Pick a slot and click a grid square to place it; BASE and L1-L7 are layers, higher ones on top. Click a placement to nudge or expand it, right click to remove it.\n\nEach placement becomes one hardware sprite - the C64 has eight per line.", targets: [] },
            { title: "ANIMATE IT", text: "Each frame holds its own placements. + NEW adds a frame, DUP copies the current one, and A / D step between frames.\n\nPLAY previews the animation; FWD, REV, PNG (ping-pong) and ONCE set the direction, and START, END and FPS set the range and speed.", targets: [] },
            { title: "CONVERT TO NODES", text: "CONVERT TO NODES, at the bottom of the compositor, makes SPRITE nodes for the current frame - and an ANIMATE node when two or more frames are in range (max 8 placements per frame).\n\nJSR the show routine once, then the animate routine every frame after a VWAIT. A message gives you the names.", targets: [] },
            { title: "COMMIT AND EXPORT", text: "Finish with CLOSE (COMMIT EDITS) - the project keeps the sprites and your source file is never overwritten. Autosave covers the rest.\n\nEXPORT SPRED64, EXPORT BIN and EXPORT SPD save copies for other tools.", targets: ["EXPORT SPRED64", "EXPORT BIN", "EXPORT SPD"] }
        ],
        SPRITE_MASK : [
            { title: "WHAT A SPRITE MASK DOES", text: "A sprite mask lets sprites walk behind parts of a bitmap scene - a pillar, a tree, a wall in front.\n\nYou paint the foreground over the bitmap, and on the C64 those pixels are cut out of the sprite, 8x8 cell by cell.", targets: [] },
            { title: "PICK THE PICTURE", text: "Choose the bitmap to paint over from the REFERENCE BITMAP list on the right. Click a name to use it; the wheel scrolls the list.", targets: [] },
            { title: "STEP 1: WHEN TO HIDE", text: "ALWAYS HIDE THE CAT (magenta) hides the sprite wherever it is - for walls always in front.\n\nHIDE ABOVE A Y LINE (cyan) hides it only while its feet are above a line you click on the bitmap, where the object meets the ground. Below the line it walks in front.", targets: ["ALWAYS HIDE THE CAT", "HIDE ABOVE A Y LINE"] },
            { title: "STEP 2: PAINT THE MASK", text: "Pick PAINT MASK, FILL AREA or ERASE MASK, set BRUSH SIZE, then paint on the canvas: left uses the tool, right erases, SHIFT draws a line. Wheel zooms, middle drag pans, CTRL+Z undoes.\n\nCHANGE EXISTING MASK brushes the step 1 rule onto mask already painted.", targets: ["PAINT MASK", "FILL AREA", "ERASE MASK", "BRUSH SIZE*"] },
            { title: "TEST IT", text: "TEST SPRITE puts a sprite on the canvas, masked exactly as the C64 will mask it. Drag it around to check the edges.\n\nKeep an eye on the shape count under the canvas - up to 255 different 8x8 shapes fit.", targets: ["TEST SPRITE*"] },
            { title: "USE IT IN NODES", text: "Add a SPRITE MASK node, choose this asset as its SOURCE, list the sprite slots to mask and set HOT Y to the sprite's feet.\n\nJSR its routine once per frame, after moving and animating. The mask autosaves with the project.", targets: [] }
        ],
        ANIMATION : [
            { title: "WHAT AN ANIMATION IS", text: "An animation holds named sequences - WALK, JUMP, IDLE - played by one routine. Each step says which sprite to show on each layer.\n\nANIM SET nodes use it; SELECT and ALIAS stay on each node, so several nodes can share one animation.", targets: [] },
            { title: "CHOOSE THE SPRITE BANK", text: "Use the < and > buttons on the SPRITE BANK row to pick the sprite set the frames come from. Its sprites fill the grid at the bottom.", targets: ["SPRITE BANK:*"] },
            { title: "ROWS ARE SEQUENCES", text: "Each row is one sequence. < and > on the top row move between rows, click the name to rename it, + ROW and - ROW add and delete.\n\nDELAY is how many 50 Hz frames each step lasts - lower is faster. LOOP off stops on the last step, for one-shot moves.", targets: ["+ ROW", "- ROW", "DELAY*", "LOOP"] },
            { title: "LAYERS", text: "LAYERS are hardware sprites shown together at each step, up to 8, with layer 0 in front. Click a number to edit that layer; - and + remove or add layers.", targets: ["LAYERS:"] },
            { title: "BUILD THE STEPS", text: "Click a step in the timeline, then click a sprite in the bank grid to put it on the current layer. + STEP and - STEP add and remove steps.\n\nYou can also click the layer's frame list and type sprite numbers, like 0,1,2,1, then ENTER.", targets: ["+ STEP", "- STEP"] },
            { title: "PREVIEW", text: "PLAY runs the row at PAL speed and the LAYERS TOGETHER box shows all layers combined. CTRL+Z / CTRL+Y undo and redo.\n\nAll rows together can hold 255 steps - the count at the bottom warns you.", targets: ["PLAY", "STEP*"] },
            { title: "USE IT IN NODES", text: "On an ANIM SET node, EDIT opens or creates its animation and ASSET picks which one it uses. Set SELECT to the value holding the row number.\n\nJSR its _sub routine once per frame; a new row starts from its first step automatically. Changes autosave.", targets: [] }
        ],
        CHAR_SET : [
            { title: "WHAT A CHARSET IS", text: "A charset is up to 256 characters of 8x8 pixels, 8 bytes each. Text, tiles, maps and HUDs on the C64 screen are drawn from one.\n\nChars come in rows of 16, and you only pay memory for the rows you keep.", targets: [] },
            { title: "BRING A CHARSET IN", text: "IMPORT loads charset text (.txt), raw binary (.bin, .ctc) or CharPad .ctm files, replacing this one.\n\nOr COPY ROM to start from the 256 built-in C64 characters.", targets: ["IMPORT", "COPY ROM"] },
            { title: "GROW OR SHRINK IT", text: "[+] ADD ROW appends 16 blank chars, up to 256. [-] REM ROW removes the last 16. Keep only what your game needs - each row is 128 bytes.", targets: ["[+] ADD ROW", "[-] REM ROW"] },
            { title: "MODE AND COLOURS", text: "The mode button cycles HIRES (one colour per char), MULTICOLOUR (4x8 double-wide pixels, up to four colours) and ECM (four backgrounds, 64 chars only).\n\nThe colour rows below it set BG, FG and the shared colours for that mode. Click a palette swatch to set a colour and paint with it.", targets: ["HR MODE", "MC MODE", "ECM MODE", "@PALETTE", "BG:"] },
            { title: "PICK A CHARACTER", text: "Click a char in the charset grid to edit it; arrow keys over the grid move to the next one.\n\nCTRL + click or drag selects several. DELETE clears them and CTRL+C / CTRL+V copy and paste.", targets: [] },
            { title: "DRAW THE PIXELS", text: "In the large editor, left paints and right clears to background. Middle drag, SPACE + drag or the arrow keys slide the char; WRAP decides if pixels come back round the other side.\n\nCTRL+Z undoes, CTRL+Y redoes.", targets: ["WRAP*"] },
            { title: "EDITING TOOLS", text: "FLIP X and FLIP Y mirror the char, CLEAR blanks it, and FILL turns on flood-fill for the next clicks.", targets: ["FLIP X", "FLIP Y", "CLEAR", "FILL*"] },
            { title: "USE IT IN NODES", text: "A CHARSET node points the VIC at this charset through $D018. Map data, tilesets and HUDs pick their charset by name.\n\nCharsets autosave with the project. EXPORT BIN and EXPORT CTM save copies for other tools.", targets: ["EXPORT BIN", "EXPORT CTM"] }
        ]
    };
}
