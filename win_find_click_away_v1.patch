From af1373fbb2f5c779818278128b00bd3d876e2bcc Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 16 Sep 2026 13:43:43 +0000
Subject: [PATCH] code editor: click away from the find panel to dismiss it

---
 .../scr_code_editor_draw.gml                  |  2 +-
 .../scr_code_editor_draw_find_dialogue.gml    | 38 ++++++++++++++++++-
 2 files changed, 38 insertions(+), 2 deletions(-)

diff --git a/C64DevMachine_win.yyp/scripts/scr_code_editor_draw/scr_code_editor_draw.gml b/C64DevMachine_win.yyp/scripts/scr_code_editor_draw/scr_code_editor_draw.gml
index 845b8eb..1a3521c 100644
--- a/C64DevMachine_win.yyp/scripts/scr_code_editor_draw/scr_code_editor_draw.gml
+++ b/C64DevMachine_win.yyp/scripts/scr_code_editor_draw/scr_code_editor_draw.gml
@@ -1248,6 +1248,6 @@ var _g_is_valid = false;
     draw_set_color(make_color_rgb(100, 180, 200));
     draw_text(_px + 8, _py + _ph - 19, "(CTRL+ENTER) or ESCAPE to  CLOSE  |  F5: BUILD  |  CTRL+C/X/V  |  CTRL+A  |  TAB |  F12 : FONT  Z CTRL/(+SHIFT)+F FIND+REPLACE");
 	
-	if (code_editor_find_open) scr_code_editor_draw_find_dialogue(_px, _py, _pw, _mx, _my);
+	if (code_editor_find_open) scr_code_editor_draw_find_dialogue(_px, _py, _pw, _ph, _mx, _my);
 	
 }
diff --git a/C64DevMachine_win.yyp/scripts/scr_code_editor_draw_find_dialogue/scr_code_editor_draw_find_dialogue.gml b/C64DevMachine_win.yyp/scripts/scr_code_editor_draw_find_dialogue/scr_code_editor_draw_find_dialogue.gml
index 894f5f7..e22e199 100644
--- a/C64DevMachine_win.yyp/scripts/scr_code_editor_draw_find_dialogue/scr_code_editor_draw_find_dialogue.gml
+++ b/C64DevMachine_win.yyp/scripts/scr_code_editor_draw_find_dialogue/scr_code_editor_draw_find_dialogue.gml
@@ -1,4 +1,4 @@
-function scr_code_editor_draw_find_dialogue(_px, _py, _pw, _mx, _my) {
+function scr_code_editor_draw_find_dialogue(_px, _py, _pw, _ph, _mx, _my) {
     var _dw = 420;
     var _dh = 130;
     var _dx = _px + _pw - _dw - 20;
@@ -142,4 +142,40 @@ function scr_code_editor_draw_find_dialogue(_px, _py, _pw, _mx, _my) {
     draw_set_font(fnt_c64_tiny);
     draw_set_color(make_color_rgb(70, 90, 80));
     draw_text(_dx + 8, _bt_y - 25, "TAB: switch field  |  ESC: close  |  ENTER: next");
+
+    // ─── CLICK AWAY ───────────────────────────────────────────────
+    // Last thing in the function on purpose: every field and button inside
+    // the box has already had its go at this click, so anything still
+    // unclaimed landed outside the box.
+    //
+    // Outside the box but still on the editor: dismiss the box and stop
+    // there. The click is not passed through to the code area, which
+    // ignores the mouse while the find panel is open anyway (the
+    // !code_editor_find_open guards in scr_code_editor_draw) - so one
+    // click dismisses, and the next one places the cursor.
+    //
+    // Outside the editor panel: close the editor too. That commits, which
+    // is the only thing closing ever does - scr_code_editor_close has no
+    // cancel concept, so nothing typed can be lost this way.
+    if (mouse_check_button_pressed(mb_left)) {
+
+        var _in_box = (_mx >= _dx && _mx <= _dx + _dw
+                    && _my >= _dy && _my <= _dy + _dh);
+
+        if (!_in_box) {
+            code_editor_find_open         = false;
+            code_editor_find_active_field = 0;
+
+            var _in_panel = (_mx >= _px && _mx <= _px + _pw
+                          && _my >= _py && _my <= _py + _ph);
+
+            if (!_in_panel) {
+                if (instance_exists(code_editor_node)) {
+                    code_editor_node.code_cache_dirty = true;
+                }
+                code_editor_symbol_cache_dirty = true;
+                scr_code_editor_close(true);
+            }
+        }
+    }
 }
\ No newline at end of file
-- 
2.43.0

