+        // VOI64 SPEECH
+        // MASTER [1] pitch [2] speed [3] throat [4] mouth [5] zp_base
+        // SAY    [3] mode(0=TEXT,1=PHONEME) [4] src(0=INLINE,1=TEXT_DATA)
