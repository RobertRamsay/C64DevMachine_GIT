diff --git a/C64DevMachine_win.yyp/scripts/scr_org_collapse/scr_org_collapse.gml b/C64DevMachine_win.yyp/scripts/scr_org_collapse/scr_org_collapse.gml
index 5ab4e1e..fe83cf4 100644
--- a/C64DevMachine_win.yyp/scripts/scr_org_collapse/scr_org_collapse.gml
+++ b/C64DevMachine_win.yyp/scripts/scr_org_collapse/scr_org_collapse.gml
@@ -413,3 +413,116 @@ function scr_org_set_collapsed(_anchor, _collapsed) {
     // few passes so the unfolded chain closes up without waiting for a click.
