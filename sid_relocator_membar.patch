+/// Instruction length by addressing mode
+/// modes: 0 imp 1 acc 2 imm 3 zp 4 zpx 5 zpy 6 abs 7 abx 8 aby 9 ind 10 izx 11 izy 12 rel
+function scr_srel_len(_md) {
+    if (_md <= 1) { return 1; }
+    if (_md >= 6 && _md <= 9) { return 3; }
+    return 2;
+}
