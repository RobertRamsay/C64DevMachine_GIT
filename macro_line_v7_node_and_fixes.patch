diff --git a/C64DevMachine_win.yyp/scripts/scr_node_step_macro_coll_line/scr_node_step_macro_coll_line.gml b/C64DevMachine_win.yyp/scripts/scr_node_step_macro_coll_line/scr_node_step_macro_coll_line.gml
