+        if (_cached != -1) {
+            _asset.meta.preview_surf = surface_create(320, 200);
+            buffer_set_surface(_cached, _asset.meta.preview_surf, 0);
+            buffer_delete(_cached);
+            _asset.meta.has_data = true;
