@@ -141,9 +161,52 @@ function scr_asset_bmp_build_preview(_asset) {
     
 _asset.meta.preview_surf = surface_create(320, 200);
     buffer_set_surface(_surf_buf, _asset.meta.preview_surf, 0);
+    scr_asset_bmp_cache_save(_ckey, _surf_buf);
