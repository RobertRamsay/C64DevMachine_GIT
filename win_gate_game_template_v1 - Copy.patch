e, 0 = none yet\nCLASS    = $A800      ; char -> 1 wire 2 src1 3 src0 4 lamp1 5 lamp0\nMASK     = $A900      ; char -> wire sides: 1 up 2 down 4 left 8 right\nGTYPE    = $AA00      ; gate char -> 0 AND 1 OR 2 NOT 3 EOR 4 NAND\nCOLOUR   = $AB00      ; char -> idle colour\nROWLO    = $AC00      ; row*40 low byte\nROWHI    = $AC19      ; row*40 high byte (add the area's base page)\nCOLXLO   = $AC32      ; cursor sprite X per column (low)\nCOLXHI   = $AC5A      ; cursor sprite X per column (9th bit)\nROWY     = $AC82      ; cursor sprite Y per row\nLVLO     = $AC9B      ; LEVELMAP + level*1000 (low)\nLVHI     = $ACA5      ; (high)\nINV5     = $ACAF      ; level*5 into GATEINV\nFLASHTAB = $ACB9      ; cursor colour cycle (8)\nDIGPOS   = $ACC1      ; screen column of each inventory digit (5)\nNAMES    = $AD00      ; 10 level names, 20 chars each\nINVLABEL = $ADD0      ; inventory line, 40 chars\nMSGLO    = $AF20      ; message pointers (8)\nMSGHI    = $AF28\nPS  = $50             ; screen row\nPT  = $52             ; state row\nPSU = $54             ; screen row above\nPTU = $56             ; state row above\nPSD = $58             ; screen row below\nPTD = $5A             ; state row below\nPC  = $5C             ; colour RAM row\nP1  = $5E             ; general pointer\nLEVEL    = $C000      ; 0-9\nTICK     = $C001      ; pulse step number (sources are step 1)\nCHANGED  = $C002      ; set when a step lit anything\nBLOWN    = $C003      ; a 1 went through a fuse\nCUR      = $C004      ; cursor: index into the action list\nNACT     = $C005      ; number of action cells\nDELAY    = $C006      ; joystick repeat delay\nFIREHELD = $C007      ; fire edge latch\nREMAIN   = $C008      ; 5 bytes: gates left to place (AND OR NOT EOR NAND)\nROW      = $C00D\nVAL      = $C00E      ; value found by KnownBefore\nCM       = $C00F      ; current cell mask\nCK       = $C010      ; current cell class\nCH       = $C011      ; current cell char\nTMP      = $C012\nFLASH    = $C013\nAVAL     = $C014\nBVAL     = $C015\nHASA     = $C016\nHASB     = $C017\nACTLO    = $C020      ; action list: screen address low (40)\nACTHI    = $C048      ; high\nACTCOL   = $C070      ; column\nACTROW   = $C098      ; row\n\n; ---------------------------------------------------------------\n; JUDGE: every lamp must have been reached with the value it wants\n; and no fuse may have carried a 1.\n; ---------------------------------------------------------------\nJudge:\nLDA BLOWN\nBNE JFuse\nLDA #$02\nSTA ROW\nJGRow:\nJSR SetRowPtrs\nLDY #$00\nJGCol:\nLDA ($50),Y\nTAX\nLDA CLASS,X\nCMP #$04\nBCC JGNext\nCMP #$06\nBCS JGNext\nSEC                    ; 0 = wants 1, 1 = wants 0\nSBC #$04\nSTA TMP\nLDA ($52),Y\nBEQ JFail              ; never reached\nAND #$01\nEOR TMP\nBEQ JFail              ; wrong value\nJGNext:\nINY\nCPY #40\nBNE JGCol\nINC ROW\nLDA ROW\nCMP #25\nBNE JGRow\n; ---- solved ----\nLDA #$03\nJSR ShowMsg            ; \"CIRCUIT COMPLETE!\"\nJSR SndWin\nJSR WaitFire\nINC LEVEL\nLDA LEVEL\nCMP #10\nBCC JNextLevel\nLDA #$06\nJSR ShowMsg            ; \"ALL BOARDS SOLVED!\"\nJSR WaitFire\nJMP Title\nJNextLevel:\nJMP StartLevel\nJFuse:\nLDA #$05\nJSR ShowMsg            ; \"FUSE BLOWN!\"\nJSR SndFuse\nJMP JFailWait\nJFail:\nLDA #$04\nJSR ShowMsg            ; \"WRONG OUTPUT!\"\nJSR SndFail\nJFailWait:\nJSR WaitFire\nJSR ResetBoard         ; keep the player's gates, clear the pulses\nLDA #$00\nJSR ShowMsg\nLDA #$01\nSTA FIREHELD\nRTS\n\n; WaitFire: fire released, pressed, released (music keeps playing).\nWaitFire:\nJSR FrameTick\nLDA $DC00\nAND #$10\nBEQ WaitFire\nWFDown:\nJSR FrameTick\nLDA $DC00\nAND #$10\nBNE WFDown\nWFUp:\nJSR FrameTick\nLDA $DC00\nAND #$10\nBEQ WFUp\nRTS\n"]], "binary_blob": "", "custom_title": "", "stable_uid": 300057.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "params": []}, {"anim_alias": "", "x": 2600.0, "helper_text": "", "y": 160.0, "comment_w_mult": 1.0, "x_i