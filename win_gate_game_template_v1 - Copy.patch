 ; column\nACTROW   = $C098      ; row\n\n; ---------------------------------------------------------------\n; GAME LOOP body: count down the joystick repeat delay, then move\n; the cursor sprite to the selected action cell and flash it.\n; (FrameTick and the JOYSTICK node run just above this block.)\n; ---------------------------------------------------------------\nLDA DELAY\nBEQ GLNoDelay\nDEC DELAY\nGLNoDelay:\nLDX CUR\nLDY ACTCOL,X\nLDA COLXLO,Y\nSTA $D000\nLDA COLXHI,Y\nSTA $D010\nLDY ACTROW,X\nLDA ROWY,Y\nSTA $D001\nINC FLASH\nLDA FLASH\nLSR\nLSR\nAND #$07\nTAX\nLDA FLASHTAB,X\nSTA $D027\n"]], "binary_blob": "", "custom_title": "", "stable_uid": 300049.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "params": []}, {"anim_alias": "", "x": 1640.0, "helper_text": "", "y": 760.0, "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 0.0, "type": "NORMAL", "pc_address": 0.0, "height": 60.0, "title": "Opcode", "connected": true, "org_parent_x": 1640.0, "org_parent_y": 340.0, "has_org_parent": true, "code": [["jmp_abs", "GameLoop"]], "binary_blob": "", "custom_title": "", "stable_uid": 300050.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "params": []}, {"anim_alias": "", "x": 1640.0, "helper_text": "", "y": 820.0, "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": true, "end_address": 0.0, "type": "MACRO_CODE", "pc_address": 0.0, "height": 100.0, "title": "CODE BLOCK", "connected": true, "org_parent_x": 1640.0, "org_parent_y": 340.0, "has_org_parent": true, "code": [["code_block", "; (shared constants repeated so this block assembles on its own)\nSCREEN   = $0400      ; text screen (MACRO_VIC)\nLEVELMAP = $8000      ; GATE_LEVELS map asset: 40 x 250 raw chars\nGATEINV  = $A780      ; LEVEL_GATES byte data: 5 counts per level\nSTATEBUF = $C100      ; pulse state per cell: (tick*2)|value, 0 = none yet\nCLASS    = $A800      ; char -> 1 wire 2 src1 3 src0 4 lamp1 5 lamp0\nMASK     = $A900      ; char -> wire sides: 1 up 2 down 4 left 8 right\nGTYPE    = $AA00      ; gate char -> 0 AND 1 OR 2 NOT 3 EOR 4 NAND\nCOLOUR   = $AB00      ; char -> idle colour\nROWLO    = $AC00      ; row*40 low byte\nROWHI    = $AC19      ; row*40 high byte (add the area's base page)\nCOLXLO   = $AC32      ; cursor sprite X per column (low)\nCOLXHI   = $AC5A      ; cursor sprite X per column (9th bit)\nROWY     = $AC82      ; cursor sprite Y per row\nLVLO     = $AC9B      ; LEVELMAP + level*1000 (low)\nLVHI     = $ACA5      ; (high)\nINV5     = $ACAF      ; level*5 into GATEINV\nFLASHTAB = $ACB9      ; cursor colour cycle (8)\nDIGPOS   = $ACC1      ; screen column of each inventory digit (5)\nNAMES    = $AD00      ; 10 level names, 20 chars each\nINVLABEL = $ADD0      ; inventory line, 40 chars\nMSGLO    = $AF20      ; message pointers (8)\nMSGHI    = $AF28\nPS  = $50             ; screen row\nPT  = $52             ; state row\nPSU = $54             ; screen row above\nPTU = $56             ; state row above\nPSD = $58             ; screen row below\nPTD = $5A             ; state row below\nPC  = $5C             ; colour RAM row\nP1  = $5E             ; general pointer\nLEVEL    = $C000      ; 0-9\nTICK     = $C001      ; pulse step number (sources are step 1)\nCHANGED  = $C002      ; set when a step lit anything\nBLOWN    = $C003      ; a 1 went through a fuse\nCUR      = $C004      ; cursor: index into the action list\nNACT     = $C005      ; number of action cells\nDELAY    = $C006      ; joystick repeat delay\nFIREHELD = $C007      ; fire edge latch\nREMAIN   = $C008      ; 5 bytes: gates left to place (AND OR NOT EOR NAND)\nROW      = $C00D\nVAL      = $C00E      ; value found by KnownBefore\nCM       = $C00F      ; current cell mask\nCK       = $C010      ; current cell class\nCH       = $C011      ; current cell char\nTMP      = $C012\nFLASH    = $C013\nAVAL     = $C014\nBVAL     = $C015\nHASA     = $C016\nHASB     = $C017\nACTLO    = $C020      ; action list: screen address low (40)\nACTHI    = $C048      ; high\nACTCOL   = $C070      ; column\nACTROW   = $C098      ; row\n\n; ---------------------------------------------------------------\n; JOYSTICK HANDLERS (called by the JOYSTICK node, end in RTS)\n; UP/LEFT = previous action cell, DOWN/RIGHT = next, FIRE = act.\n; Holding a direction repeats every 8 frames; fire needs a release.\n; ---------------------------------------------------------------\nJoyPrev:\nLDA DELAY\nBNE JPDone\nLDA #$08\nSTA DELAY\nDEC CUR\nBPL JPMove\nLDX NACT\nDEX\nSTX CUR\nJPMove:\nJSR SndMove\nJPDone:\nRTS\n\nJoyNext:\nLDA DELAY\nBNE JNDone\nLDA #$08\nSTA DELAY\nINC CUR\nLDA CUR\nCMP NACT\nBCC JNMove\nLDA #$00\nSTA CUR\nJNMove:\nJSR SndMove\nJNDone:\nRTS\n\nJoyNone:\nLDA #$00\nSTA FIREHELD\nSTA DELAY\nRTS\n\nJoyFire:\nLDA FIREHELD\nBNE JFDone\nLDA #$01\nSTA FIREHELD\nJMP Act\nJFDone:\nRTS\n\n; ---------------------------------------------------------------\n; Act: fire on the cell under the cursor.\n;   RUN button -> run the circuit (only when every gate is placed)\n;   switch     -> flip between left and right\n;   gate slot  -> next gate type still in stock, then back to empty\n; ---------------------------------------------------------------\nAct:\nLDX CUR\nLDA ACTLO,X\nSTA P1\nLDA ACTHI,X\nSTA P1+1\nLDY #$00\nLDA ($5E),Y\nCMP #105\nBNE ActNotRun\nJMP TryRun\nActNotRun:\nCMP #97\nBNE ActNotL\nLDA #98\nJMP ActSwitch\nActNotL:\nCMP #98\nBNE ActSlot\nLDA #97\nActSwitch:\nSTA ($5E),Y\nJSR SndClick\nRTS\n\nActSlot:\n; A = 86 (empty) or 87-91 (placed gate). Put a placed gate back first.\nCMP #86\nBEQ ActFromEmpty\nSEC\nSBC #87\nTAX\nINC REMAIN,X           ; gate goes back in stock\nINX\nJMP ActSearch\nActFromEmpty:\nLDX #$00\nActSearch:\nCPX #$05\nBCS ActEmpty           ; nothing left after this type -> empty slot\nLDA REMAIN,X\nBNE ActPlace\nINX\nJMP ActSearch\nActPlace:\nDEC REMAIN,X\nTXA\nCLC\nADC #87\nJMP ActStore\nActEmpty:\nLDA #86\nActStore:\nLDY #$00\nSTA ($5E),Y\nTAX                    ; colour the slot to match its new char\nLDA P1+1\nCLC\nADC #$D4               ; screen page + $D4 = colour page\nSTA P1+1\nLDA COLOUR,X\nSTA ($5E),Y\nJSR DrawInv\nJSR SndPlace\nRTS\n\n; TryRun: refuse while gates are still in stock.\nTryRun:\nLDX #$04\nTRCheck:\nLDA REMAIN,X\nBNE TRNotYet\nDEX\nBPL TRCheck\nJMP RunCircuit\nTRNotYet:\nLDA #$01\nJSR ShowMsg            ; \"PLACE ALL GATES...\"\nJSR SndFail\nRTS\n"]], "binary_blob": "", "custom_title": "", "stable_uid": 300051.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "params": []}, {"anim_alias": "", "x": 1960.0, "helper_text": "", "y": 160.0, "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 0.0, "type": "COMMENT", "pc_address": 0.0, "height": 100.0, "title": "COMMENT", "connected": false, "org_parent_x": -1.0, "org_parent_y": -1.0, "has_org_parent": false, "code": [["Comment", "Pulses spread one cell\nper step through wires\nand gates."]], "binary_blob": "", "custom_title": "", "stable_uid": 300052.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "params": []}, {"anim_alias": "", "x": 1960.0, "helper_text": "", "y": 340.0, "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": false, "collapsed": false, "end_address": 0.0, "type": "ORG", "pc_address": 27904.0, "height": 80.0, "title": "ORG BLOCK", "connected": false, "org_parent_x": -1.0, "org_parent_y": -1.0, "has_org_parent": false, "code": [["org", 0.0]], "binary_blob": "", "custom_title": "", "stable_uid": 300053.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": 5.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "params": []}, {"anim_alias": "", "x": 1960.0, "helper_text": "", "y": 420.0, "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": true, "end_address": 0.0, "type": "MACRO_CODE", "pc_address": 0.0, "height": 100.0, "title": "CODE BLOCK", "connected": true, "org_parent_x": 1960.0, "org_parent_y": 340.0, "has_org_parent": true, "code": [["code_block", "; (shared constants repeated so this block assembles on its own)\nSCREEN   = $0400      ; text screen (MACRO_VIC)\nLEVELMAP = $8000      ; GATE_LEVELS map asset: 40 x 250 raw chars\nGATEINV  = $A780      ; LEVEL_GATES byte data: 5 counts per level\nSTATEBUF = $C100      ; pulse state per cell: (tick*2)|value, 0 = none yet\nCLASS    = $A800      ; char -> 1 wire 2 src1 3 src0 4 lamp1 5 lamp0\nMASK     = $A900      ; char -> wire sides: 1 up 2 down 4 left 8 right\nGTYPE    = $AA00      ; gate char -> 0 AND 1 OR 2 NOT 3 EOR 4 NAND\nCOLOUR   = $AB00      ; char -> idle colour\nROWLO    = $AC00      ; row*40 low byte\nROWHI    = $AC19      ; row*40 high byte (add the area's base page)\nCOLXLO   = $AC32      ; cursor sprite X per column (low)\nCOLXHI   = $AC5A      ; cursor sprite X per column (9th bit)\nROWY     = $AC82      ; cursor sprite Y per row\nLVLO     = $AC9B      ; LEVELMAP + level*1000 (low)\nLVHI     = $ACA5      ; (high)\nINV5     = $ACAF      ; level*5 into GATEINV\nFLASHTAB = $ACB9      ; cursor colour cycle (8)\nDIGPOS   = $ACC1      ; screen column of each inventory digit (5)\nNAMES    = $AD00      ; 10 level names, 20 chars each\nINVLABEL = $ADD0      ; inventory line, 40 chars\nMSGLO    = $AF20      ; message pointers (8)\nMSGHI    = $AF28\nPS  = $50             ; screen row\nPT  = $52             ; state row\nPSU = $54             ; screen row above\nPTU = $56             ; state row above\nPSD = $58             ; screen row below\nPTD = $5A             ; state row below\nPC  = $5C             ; colour RAM row\nP1  = $5E             ; general pointer\nLEVEL    = $C000      ; 0-9\nTICK     = $C001      ; pulse step number (sources are step 1)\nCHANGED  = $C002      ; set when a step lit anything\nBLOWN    = $C003      ; a 1 went through a fuse\nCUR      = $C004      ; cursor: index into the action list\nNACT     = $C005      ; number of action cells\nDELAY    = $C006      ; joystick repeat delay\nFIREHELD = $C007      ; fire edge latch\nREMAIN   = $C008      ; 5 bytes: gates left to place (AND OR NOT EOR NAND)\nROW      = $C00D\nVAL      = $C00E      ; value found by KnownBefore\nCM       = $C00F      ; current cell mask\nCK       = $C010      ; current cell class\nCH       = $C011      ; current cell char\nTMP      = $C012\nFLASH    = $C013\nAVAL     = $C014\nBVAL     = $C015\nHASA     = $C016\nHASB     = $C017\nACTLO    = $C020      ; action list: screen address low (40)\nACTHI    = $C048      ; high\nACTCOL   = $C070      ; column\nACTROW   = $C098      ; row\n\n; ---------------------------------------------------------------\n; PULSE SIMULATION\n; Every step looks at each cell that has no value yet:\n;   wire / lamp / fuse: takes the value of a connected neighbour that\n;     already had one before this step (its side must face this cell)\n;   gate: fires once its inputs (left and right wires) both have values;\n;     NOT uses whichever single input is wired.\n; A cell's state is (step*2)|value, so \"had a value before this step\"\n; is state<>0 and state/2 < TICK.  One step per 2 frames shows the\n; pulses travelling up the board.\n; ---------------------------------------------------------------\nRunCircuit:\nJSR ResetBoard\nLDA #$02\nJSR ShowMsg            ; \"PULSE RUNNING...\"\nLDA #$00\nSTA $D015              ; hide the cursor while it runs\nLDA #$02\nSTA TICK\nRCStep:\nLDA #$00\nSTA CHANGED\nJSR SimStep\nLDA CHANGED\nBEQ RCQuiet\nJSR SndTick            ; soft tick while pulses move\nRCQuiet:\nJSR FrameTick\nJSR FrameTick\nLDA CHANGED\nBEQ RCDone\nINC TICK\nLDA TICK\nCMP #120\nBCC RCStep\nRCDone:\nLDA #$01\nSTA $D015\nJMP Judge\n\n; ResetBoard: idle colours back, pulse state cleared, sources primed\n; as step 1 (state 3 = value 1, state 2 = value 0).\nResetBoard:\nLDA #$00\nSTA BLOWN\nLDA #$02\nSTA ROW\nRBRow:\nJSR SetRowPtrs\nLDY #$00\nRBCol:\nLDA ($50),Y\nTAX\nLDA COLOUR,X\nSTA ($5C),Y\nLDA CLASS,X\nCMP #$02\nBNE RBNot1\nLDA #$03\nJMP RBSet\nRBNot1:\nCMP #$03\nBNE RBNone\nLDA #$02\nJMP RBSet\nRBNone:\nLDA #$00\nRBSet:\nSTA ($52),Y\nINY\nCPY #40\nBNE RBCol\nINC ROW\nLDA ROW\nCMP #25\nBNE RBRow\nRTS\n\n; SeedSources: same as ResetBoard (used after a level is drawn).\nSeedSources:\nJMP ResetBoard\n\n; KnownBefore: A = a neighbour's state. Carry set + VAL = its value\n; when it had one before this step.\nKnownBefore:\nSTA TMP\nBEQ KBNo\nLSR\nCMP TICK\nBCS KBNo\nLDA TMP\nAND #$01\nSTA VAL\nSEC\nRTS\nKBNo:\nCLC\nRTS\n\nSimStep:\nLDA #$02\nSTA ROW\nSSRow:\nJSR SetRowPtrs\nLDY #$00\nSSCol:\nLDA ($52),Y\nBNE SSNext             ; already has a value\nLDA ($50),Y\nSTA CH\nTAX\nLDA CLASS,X\nSTA CK\nCMP #$06\nBNE SSNotGate\nJMP GateCell\nSSNotGate:\nCMP #$01\nBEQ WireCell\nCMP #$04\nBEQ WireCell\nCMP #$05\nBEQ WireCell\nCMP #$08\nBEQ WireCell\nSSNext:\nINY\nCPY #40\nBNE SSCol\nINC ROW\nLDA ROW\nCMP #25\nBNE SSRow\nRTS\n\n; ---- wire, lamp or fuse cell ----\nWireCell:\nLDA MASK,X\nSTA CM\nAND #$01               ; joined upward?\nBEQ WCDown\nLDA ($54),Y\nTAX\nLDA MASK,X\nAND #$02               ; ...and the cell above joins down\nBEQ WCDown\nLDA ($56),Y\nJSR KnownBefore\nBCS WCSet\nWCDown:\nLDA CM\nAND #$02\nBEQ WCLeft\nLDA ($58),Y\nTAX\nLDA MASK,X\nAND #$01\nBEQ WCLeft\nLDA ($5A),Y\nJSR KnownBefore\nBCS WCSet\nWCLeft:\nLDA CM\nAND #$04\nBEQ WCRight\nDEY\nLDA ($50),Y\nTAX\nLDA MASK,X\nAND #$08\nBEQ WCLeftN\nLDA ($52),Y\nJSR KnownBefore\nINY\nBCS WCSet\nJMP WCRight\nWCLeftN:\nINY\nWCRight:\nLDA CM\nAND #$08\nBEQ WCNone\nINY\nLDA ($50),Y\nTAX\nLDA MASK,X\nAND #$04\nBEQ WCRightN\nLDA ($52),Y\nJSR KnownBefore\nDEY\nBCS WCSet\nJMP WCNone\nWCRightN:\nDEY\nWCNone:\nJMP SSNext\n\nWCSet:\nJSR StoreVal           ; state + \"changed\"\nLDA CK\nCMP #$08\nBEQ WCFuse\nCMP #$04\nBCS WCLamp             ; 4 or 5\nLDA VAL                ; wire: light green = 1, dark grey = 0\nBEQ WCZero\nLDA #$0D\nJMP WCCol\nWCZero:\nLDA #$0B\nWCCol:\nSTA ($5C),Y\nJMP SSNext\nWCLamp:\n; lamp 4 wants 1, lamp 5 wants 0: white when right, red when wrong\nSEC\nSBC #$04               ; 0 = wants 1, 1 = wants 0\nEOR VAL                ; 1 when right\nBEQ WCLampBad\nLDA #$01\nJMP WCCol\nWCLampBad:\nLDA #$02\nJMP WCCol\nWCFuse:\nLDA VAL\nBEQ WCZero\nLDA #$01\nSTA BLOWN\nLDA #$02\nJMP WCCol\n\nStoreVal:\nLDA TICK\nASL\nORA VAL\nSTA ($52),Y\nLDA #$01\nSTA CHANGED\nRTS\n\n; ---- gate cell: inputs are the wires to its left and right ----\nGateCell:\nLDA GTYPE,X\nSTA CM                 ; CM = gate type here\nLDA #$00\nSTA HASA\nSTA HASB\nDEY                    ; left input: joined to the right?\nLDA ($50),Y\nTAX\nLDA MASK,X\nAND #$08\nBEQ GCNoA\nLDA #$01\nSTA HASA\nLDA ($52),Y\nJSR KnownBefore\nBCC GCNoA\nLDA VAL\nSTA AVAL\nLDA #$02\nSTA HASA               ; 2 = wired and has a value\nGCNoA:\nINY\nINY                    ; right input: joined to the left?\nLDA ($50),Y\nTAX\nLDA MASK,X\nAND #$04\nBEQ GCNoB\nLDA #$01\nSTA HASB\nLDA ($52),Y\nJSR KnownBefore\nBCC GCNoB\nLDA VAL\nSTA BVAL\nLDA #$02\nSTA HASB\nGCNoB:\nDEY\nLDA CM\nCMP #$02\nBNE GCTwo\n; NOT: the left input if wired, otherwise the right one\nLDA HASA\nBEQ GCNotB\nCMP #$02\nBNE GCWait\nLDA AVAL\nJMP GCInvert\nGCNotB:\nLDA HASB\nCMP #$02\nBNE GCWait\nLDA BVAL\nGCInvert:\nEOR #$01\nJMP GCOut\nGCTwo:\nLDA HASA\nCMP #$02\nBNE GCWait\nLDA HASB\nCMP #$02\nBNE GCWait\nLDA CM\nBEQ GCAnd\nCMP #$01\nBEQ GCOr\nCMP #$03\nBEQ GCEor\nLDA AVAL               ; NAND\nAND BVAL\nEOR #$01\nJMP GCOut\nGCAnd:\nLDA AVAL\nAND BVAL\nJMP GCOut\nGCOr:\nLDA AVAL\nORA BVAL\nJMP GCOut\nGCEor:\nLDA AVAL\nEOR BVAL\nGCOut:\nSTA VAL\nJSR StoreVal\nLDA VAL                ; gate lights up with its output\nBEQ GCZero\nLDA #$0D\nJMP GCCol\nGCZero:\nLDA #$0B\nGCCol:\nSTA ($5C),Y\nGCWait:\nJMP SSNext\n"]], "binary_blob": "", "custom_title": "", "stable_uid": 300054.0