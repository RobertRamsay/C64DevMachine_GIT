-draw_set_valign(fa_middle);
+draw_set_valign(fa_top);
 
 var _msg_x = _bx + box_w * 0.5;
-var _msg_y = _by + 60;
+var _msg_y = _by + _pad_top;
 
-draw_text_ext(_msg_x, _msg_y, message, 24, box_w - 60);
