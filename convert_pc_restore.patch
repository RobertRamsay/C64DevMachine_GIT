+            array_push(_result, ["pc", -2]);
+            continue;
+        }
+        if (_mnem_raw == ".PCRESTORE") {
+            array_push(_result, ["_line_map_", _li + 1]);
+            array_push(_result, ["pc", -3]);
+            continue;
+        }
+
