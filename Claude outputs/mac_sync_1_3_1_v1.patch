+        var _page = _wm.palette_page[_p];
+        for (var _i = 0; _i < array_length(_page); _i++) {
+            if (is_struct(_page[_i]) && _page[_i][$ "title"] == _title && variable_struct_exists(_page[_i], "instructions")) {
+                return _page[_i];
