+        if (_rv != 0) {
+            _E("ldx_abs", _rv);
+            _E("beq", _pfx + "rskp");
+            _L(_pfx + "rmul");
+            _A(_zd, 320);
+            _E("dex", 0);
+            _E("bne", _pfx + "rmul");
+            _L(_pfx + "rskp");
+        }
