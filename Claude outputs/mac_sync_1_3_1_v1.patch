+            }
+        }
+        if (_n.node_type == "ORG") {
+            var _wi = _org_map[$ string(_r[$ "wire_in_source"] ?? -1)];
+            var _wo = _org_map[$ string(_r[$ "wire_out_target"] ?? -1)];
