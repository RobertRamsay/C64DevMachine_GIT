+        var _base = _bmp + ((_rv == 0) ? _row * 320 : 0) + ((_cv == 0) ? _col * 8 : 0);
+        _E("lda_imm", _base & 0xFF);        _E("sta_zp", _zd);
+        _E("lda_imm", (_base >> 8) & 0xFF); _E("sta_zp", _zd + 1);
+        if (_cv != 0) {
+            _E("ldx_abs", _cv);
+            _E("beq", _pfx + "cskp");
+            _L(_pfx + "cmul");
+            _A(_zd, 8);
+            _E("dex", 0);
+            _E("bne", _pfx + "cmul");
+            _L(_pfx + "cskp");
