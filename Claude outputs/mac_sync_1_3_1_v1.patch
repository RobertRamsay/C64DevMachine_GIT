+        if (_save) _E("sta_izy", _zs);
+        _E("and_zp", _tm);
+        _E("ora_zp", _tg);
+        _E("sta_izy", _zt);
+        if (_m.bottom_up == 1) { _E("tya", 0); _E("eor_imm", 7); _E("tay", 0); }
