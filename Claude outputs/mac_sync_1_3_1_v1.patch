+        _L(_pfx + "do");
+        _E("lda_zp", _zd);     _E("sta_zp", _zt);
+        _E("lda_zp", _zd + 1); _E("sta_zp", _zt + 1);
+        _E("lda_lab", _cm ? _pfx + "vh" : _pfx + "vw");
+        _E("sta_zp", _ci);
+        _L(_pfx + "di");
+        _E("ldy_imm", 7);
+        _L(_pfx + "db");
+        _E("lda_izy", _zm);
+        if (_m.mask_and != 1) _E("eor_imm", 0xFF);
+        _E("sta_zp", _tm);
+        _E("lda_izy", _zg);
+        _E("sta_zp", _tg);
+        // bottom-up cells: byte y of the data is pixel row 7-y (= y EOR 7)
