diff --git a/C64DevMachine_win.yyp/objects/obj_workspace_manager/Create_0.gml b/C64DevMachine_win.yyp/objects/obj_workspace_manager/Create_0.gml
index 72661a1..330e7ce 100644
--- a/C64DevMachine_win.yyp/objects/obj_workspace_manager/Create_0.gml
+++ b/C64DevMachine_win.yyp/objects/obj_workspace_manager/Create_0.gml
@@ -418,7 +418,35 @@ box_next_col_idx = 0;
 grid_surface   = -1;
 grid_w         = room_width;
 grid_h         = room_height;
+// Export folder: prefer C:\C64Temp\, fall back to the per-user save folder
+// (game_save_id) when C:\ is not writable. Inline on purpose: a method
+// declared later in this event is not set yet at this point (1.2.8.0 crash).
 export_dir     = "C:\\C64Temp\\";
+var _export_ok = false;
+if (!directory_exists(export_dir))
+{
+    directory_create(export_dir);
+}
+if (directory_exists(export_dir))
+{
+    var _probe_path = export_dir + "write_test.tmp";
+    var _probe_file = file_text_open_write(_probe_path);
+    if (_probe_file != -1)
+    {
+        file_text_close(_probe_file);
+        file_delete(_probe_path);
+        _export_ok = true;
+    }
+}
+if (!_export_ok)
+{
+    export_dir = game_save_id + "C64Temp\\";
+    if (!directory_exists(export_dir))
+    {
+        directory_create(export_dir);
+    }
+    show_debug_message("Export folder fallback: " + export_dir);
+}
 file_name      = "program.prg";
 full_save_path = export_dir + file_name;
 readyToQuit    = 0;
