 /// Saveable form of the meta (mask + depths as base64, the rest plain).
+/// The editor's draggable TEST SPRITE: a 24x21 hires cat face.
+/// X fur, o eyes/mouth, n nose, w whiskers, . clear.
+function scr_sprmask_test_pattern() {
+    static _rows = [
+        "...XX..............XX...",
+        "..XXXX............XXXX..",
+        "..XXnXX..........XXnXX..",
+        "..XXnnXX........XXnnXX..",
+        "..XXXXXXXXXXXXXXXXXXXX..",
+        ".XXXXXXXXXXXXXXXXXXXXXX.",
+        ".XXXXXXXXXXXXXXXXXXXXXX.",
+        ".XXXXXXXXXXXXXXXXXXXXXX.",
+        ".XXXXooXXXXXXXXXXooXXXX.",
+        ".XXXXooXXXXXXXXXXooXXXX.",
+        ".XXXXXXXXXXXXXXXXXXXXXX.",
+        "wwXXXXXXXXXnnXXXXXXXXXww",
+        ".XXXXXXXXXXnnXXXXXXXXXX.",
+        "wwXXXXXXXXooooXXXXXXXXww",
+        ".XXXXXXXXoXXXXoXXXXXXXX.",
+        "..XXXXXXXXXXXXXXXXXXXX..",
+        "..XXXXXXXXXXXXXXXXXXXX..",
+        "...XXXXXXXXXXXXXXXXXX...",
+        "....XXXXXXXXXXXXXXXX....",
+        ".....XXXXXXXXXXXXXX.....",
+        ".......XXXXXXXXXX......."
+    ];
+    return _rows;
+}
+
 function scr_sprmask_save_meta(_asset) {
