+function scr_mts_course_slices(_m) {
+    var _out = [];
+    for (var _ci = 0; _ci < array_length(_m.chains); _ci++) {
+        var _cs = scr_mts_chain_slices(_m, _ci);
+        for (var _i = 0; _i < array_length(_cs); _i++) {
