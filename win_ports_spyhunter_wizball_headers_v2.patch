dow (now)\n    lda $fb\n    beq IRQTOP_SKIP8\n    lda $cd\n    clc\n    adc $34                  ; scroll speed (px\/frame)\n    sta $cd\nIRQTOP_SKIP8:\n    lda $3e                  ; fine Y scroll\n    and #$07\n    clc\n    adc $34                  ; scroll speed (px\/frame)\n    cmp #$08\n    php\n    and #$07\n    ora #$10\n    sta $3e                  ; fine Y scroll\n    sta $3d                  ; $d011 shadow\n    plp\n    bcs IRQTOP_PART3\n    jmp IRQTOP_SKIP17\nIRQTOP_PART3:\n    dec $48                  ; rows left in segment\n    beq IRQTOP_PART4\n    lda $28                  ; road row src ptr\n    clc\n    adc #$20\n    sta $28                  ; road row src ptr\n    bcc IRQTOP_SKIP9\n    inc $29                  ; road row src ptr hi\nIRQTOP_SKIP9:\n    jmp IRQTOP_SKIP16\nIRQTOP_PART4:\n    dec $46                  ; segment reps left\n    beq IRQTOP_PART5\n    lda $47                  ; segment rows\n    sta $48                  ; rows left in segment\n    lda $2e                  ; segment start\n    sta $28                  ; road row src ptr\n    lda $2f                  ; segment start hi\n    sta $29                  ; road row src ptr hi\n    beq IRQTOP_PART5\n    jmp IRQTOP_SKIP16\nIRQTOP_PART5:\n    lda #$17\n    sta $4d10\n    dec $43                  ; segments left in sequence\n    bne IRQTOP_SKIP15\n    jsr NEXT_SECTION         ; PORT: next section from SH_ROAD_NEXT_A \/ _B (was the $AC0D pair table)\n    .byte $ea,$ea,$ea,$ea,$ea,$ea,$ea,$ea,$ea,$ea,$ea\n    sta $42                  ; sequence number\n    tay\n    lda SH_ROAD_CHAINLO,y    ; PORT: was $AC4D - section map list lo\n    sta $2c                  ; sequence ptr\n    lda SH_ROAD_CHAINHI,y    ; PORT: was $AC6C - section map list hi\n    sta $2d                  ; sequence ptr hi\n    lda SH_ROAD_CHAINLEN,y   ; PORT: was $AC8B - maps in the section\n    sta $43                  ; segments left in sequence\n    cpy #$1c\n    bne IRQTOP_SKIP11\n    inc $fa\n    ldx $4d19\n    bmi IRQTOP_SKIP11\n    sec\n    ror $4d1a,x\n    dec $4d19\n    inc $dd\nIRQTOP_SKIP11:\n    lda $fa\n    and #$03\n    sta $fa\n    cpy #$0f\n    bne IRQTOP_SKIP12\n    inc $e5\nIRQTOP_SKIP12:\n    cpy #$1b\n    bne IRQTOP_SKIP14\n    cmp #$01\n    bne IRQTOP_SKIP14\n    ldx $4a                  ; course level\n    cpx #$13\n    bcs IRQTOP_SKIP13\n    inc $e6\n    .byte $2c    ; $858E overlapping-instruction trick (skip byte)\nIRQTOP_SKIP13:\n    inc $e7\nIRQTOP_SKIP14:\n    jsr PALETTE_ADD          ; PORT: was clc \/ adc $ACAA,y - section colour set\n    nop\n    tay\n    lda $acc9,y              ; COURSE: background colour\n    sta $36                  ; colour: background\n    lda $acd2,y              ; COURSE: MC1 colour\n    sta $37                  ; colour: MC1\n    lda $acdb,y              ; COURSE: MC2 colour\n    sta $38                  ; colour: MC2\n    lda $34                  ; scroll speed (px\/frame)\n    lsr\n    clc\n    adc #$2f\n    sta $3c                  ; next raster line\nIRQTOP_SKIP15:\n    ldy $43                  ; segments left in sequence\n    dey\n    lda $44                  ; segment id\n    sta $45                  ; previous segment id\n    lda ($2c),y              ; sequence ptr\n    sta $44                  ; segment id\n    tay\n    lda SH_ROAD_MAPLO,y      ; PORT: was $AD59 - segment address lo\n    sta $28                  ; road row src ptr\n    sta $2e                  ; segment start\n    lda SH_ROAD_MAPHI,y      ; PORT: was $AD73 - segment address hi\n    sta $29                  ; road row src ptr hi\n    sta $2f                  ; segment start hi\n    lda SH_ROAD_MAPROWS,y    ; PORT: was $AD8D - segment rows\n    sta $48                  ; rows left in segment\n    sta $47                  ; segment rows\n    lda SH_ROAD_MAPREPS,y    ; PORT: was $ADA7 - segment repeats\n    sta $46                  ; segment reps left\nIRQTOP_SKIP16:\n    inc $41                  ; new road row ready\n    lda $40                  ; $d018 shadow (playfield)\n    eor #$10\n    sta $40                  ; $d018 shadow (playfield)\n    sta $3f                  ; $d018 shadow (now)\n    lda $4d03\n    eor #$04\n    sta $4d03\n    tay\n    lda $8617,y\n    sta $2a                  ; road row dest ptr\n    lda $8618,y\n    sta $2b                  ; road row dest ptr hi\n    lda $8619,y\n    sta $2897                ; speedcode entry vector\n    lda $861a,y\n    sta $2898\nIRQTOP_SKIP17:\n    lda #$06\n    sta $d012                ; raster\n    lda #$01\n    sta $d019                ; VIC IRQ flags\n    jsr SND_TICK             ; PORT: was jsr $aab7 - effects driver + Music Maker tunes\nIRQTOP_SKIP18:\n    lda $4d0d                ; IRQ half flag\n    eor #$ff\n    sta $4d0d                ; IRQ half flag\n    pla\n    tay\n    pla\n    tax\n    pla\n    rti\n    .byte $04,$78,$01,$16,$04,$7c,$00,$04                                   ; $8617\n"]],"binary_blob":""},{"x":3040.0,"y":180.0,"type":"MACRO_CODE","custom_title":"","stable_uid":100035.0,"wire_in_source":-1.0,"wire_out_target":-1.0,"org_uid":-1.0,"show_only_used":false,"code_descriptor":"MUSIC + SOUND MIX $E000","scroll_alias":"","anim_alias":"","helper_text":"","comment_w_mult":1.0,"x_indent":0.0,"proxy":true,"collapsed":false,"end_address":58084.0,"pc_address":57344.0,"height":100.0,"title":"Code Block","connected":true,"org_parent_x":3040.0,"org_parent_y":100.0,"has_org_parent":true,"code":[["code_block","; SPY HUNTER - MUSIC + SOUND MIX ($E000)  added by the port, not in the original cartridge\n; The soundtrack is ONE Music Maker song, SH_MUSIC, played by the SID SONG node below with\n; VOICE LOCK on. The cartridge's own driver ($AA59) still plays every sound effect.\n; As in the original, an effect that starts on a channel takes that voice for the rest of\n; the life: MUS_OWNn is copied into the song's sng100301_vlock (+0\/+7\/+14) every frame, so the\n; song drops that voice's rows and writes nothing to it, while its clock carries on.\n; The next music start ($934C) clears the locks and restarts the song from row 0.\n;\n; Zero page: the player's 44-byte block is $03-$2E (SID SONG ZP base). The game uses that\n; zero page too, so SND_TICK swaps it with MUS_ZP ($FF00) around the player.\n; Cart patches that call in here (all same size as the original bytes):\n;   $8606 jsr SND_TICK (was jsr $AAB7)   $934C music start -> MUS_START\n;   $AA6C\/$AA74\/$AA7C idle checks -> MUS_IDLEn   $AA82 -> MUS_OWNSET   $AAA0 -> MUS_STOP\n\n; --- once a frame, from the raster IRQ ($8606)\nSND_TICK:\n    jsr SFX_TICK              ; the cartridge driver - sound effects only now\n    lda MUS_REQ\n    ora MUS_ON\n    bne SND_GO\n    rts\nSND_GO:\n    jsr MUS_ZPSWAP           ; game zero page out, music zero page in\n    lda MUS_REQ\n    beq SND_PLAY\n    lda #$00                 ; (re)start the song from its first row\n    sta MUS_REQ\n    sta MUS_OWN0\n    sta MUS_OWN1\n    sta MUS_OWN2\n    sta MUS_FRL\n    sta MUS_FRH\n    lda #$01\n    sta MUS_ON\n    lda #$00                 ; song 0\n    ldx #$00                 ; row 0\n    jsr sng100301_seek       ; seek, not init: init banks the KERNAL in under this code\nSND_PLAY:\n    lda MUS_OWN0\n    ldx #$00\n    sta sng100301_vlock,x    ; voice 1 locked while a sound effect owns it\n    lda MUS_OWN1\n    ldx #$07\n    sta sng100301_vlock,x    ; voice 2 locked while a sound effect owns it\n    lda MUS_OWN2\n    ldx #$0e\n    sta sng100301_vlock,x    ; voice 3 locked while a sound effect owns it\n    jsr sng100301_play\n    jsr MUS_ZPSWAP           ; game zero page back\n; music clock (frames into the current pass of the song, which repeats every\n; 2688 frames) and the channel-busy flags the idle checks read\n    inc MUS_FRL\n    bne SND_CLK0\n    inc MUS_FRH\nSND_CLK0:\n    lda MUS_FRH\n    cmp #$0a\n    bne SND_CLK\n    lda MUS_FRL\n    cmp #$80\n    bne SND_CLK\n    lda #$00                 ; song looped back to row 0\n    sta MUS_FRL\n    sta MUS_FRH\nSND_CLK:\n    lda #$00\n    sta MUS_BUSY0\n    sta MUS_BUSY1\n    sta MUS_BUSY2\n    lda MUS_OWN1\n    bne SND_B0\n    lda #$01                 ; the bass never ends\n    sta MUS_BUSY1\nSND_B0:\n    lda MUS_OWN0\n    bne SND_N0\n    lda MUS_FRH\n    cmp #$0a                 ; frames < 2592 ?\n    bcc SND_Y0\n    bne SND_N0\n    lda MUS_FRL\n    cmp #$20\n    bcs SND_N0\nSND_Y0:\n    lda #$01\n    sta MUS_BUSY0\nSND_N0:\n    lda MUS_OWN2\n    bne SND_N2\n    lda MUS_FRH\n    cmp #$02                 ; frames < 672 ?\n    bcc SND_Y2\n    bne SND_N2\n    lda MUS_FRL\n    cmp #$a0\n    bcs SND_N2\nSND_Y2:\n    lda #$01\n    sta MUS_BUSY2\nSND_N2:\n    rts\n\n; --- $934C: start the in-game music (was: streams 2\/4\/6 on channels 1\/0\/2)\nMUS_START:\n    lda #$01\n    sta MUS_REQ              ; picked up by the next SND_TICK\n    rts\n\n; --- $AAA0, inside 'stop all channels' $AA9E: music off too. Returns A = 0.\nMUS_STOP:\n    lda #$00\n    sta MUS_ON\n    sta MUS_REQ\n    sta MUS_BUSY0\n    sta MUS_BUSY1\n    sta MUS_BUSY2\n    sta $d404                ; gate off, all three voices (the original bytes)\n    sta $d40b\n    sta $d412\n    rts\n\n; --- $AA82: a stream starts on channel A -> that voice belongs to the sound effect\nMUS_OWNSET:\n    stx $08                  ; (the two original instructions)\n    tax\n    lda #$ff\n    sta MUS_OWN,x\n    rts\n\n; --- $AA6C\/$AA74\/$AA7C: 'start only if the channel is idle' - the tune counts as busy\nMUS_IDLE0:\n    lda $55                  ; channel 0 stream (sound effect) active?\n    ora MUS_BUSY0\n    beq MUS_IGO0\n    rts\nMUS_IGO0:\n    jmp CH0_START              ; start it (the forced entry)\nMUS_IDLE1:\n    lda $56                  ; channel 1 stream (sound effect) active?\n    ora MUS_BUSY1\n    beq MUS_IGO1\n    rts\nMUS_IGO1:\n    jmp CH1_START              ; start it (the forced entry)\nMUS_IDLE2:\n    lda $57                  ; channel 2 stream (sound effect) active?\n    ora MUS_BUSY2\n    beq MUS_IGO2\n    rts\nMUS_IGO2:\n    jmp CH2_START              ; start it (the forced entry)\n\n; --- swap $03-$2E with MUS_ZP ($FF00)\nMUS_ZPSWAP:\n    lda $03\n    ldx $ff00\n    sta $ff00\n    stx $03\n    lda $04\n    ldx $ff01\n    sta $ff01\n    stx $04\n    lda $05\n    ldx $ff02\n    sta $ff02\n    stx $05\n    lda $06\n    ldx $ff03\n    sta $ff03\n    stx $06\n    lda $07\n    ldx $ff04\n    sta $ff04\n    stx $07\n    lda $08\n    ldx $ff05\n    sta $ff05\n    stx $08\n    lda $09\n    ldx $ff06\n    sta $ff06\n    stx $09\n    lda $0a\n    ldx $ff07\n    sta $ff07\n    stx $0a\n    lda $0b\n    ldx $ff08\n    sta $ff08\n    stx $0b\n    lda $0c\n    ldx $ff09\n    sta $ff09\n    stx $0c\n    lda $0d\n    ldx $ff0a\n    sta $ff0a\n    stx $0d\n    lda $0e\n    ldx $ff0b\n    sta $ff0b\n    stx $0e\n    lda $0f\n    ldx $ff0c\n    sta $ff0c\n    stx $0f\n    lda $10\n    ldx $ff0d\n    sta $ff0d\n    stx $10\n    lda $11\n    ldx $ff0e\n    sta $ff0e\n    stx $11\n    lda $12\n    ldx $ff0f\n    sta $ff0f\n    stx $12\n    lda $13\n    ldx $ff10\n    sta $ff10\n    stx $13\n    lda $14\n    ldx $ff11\n    sta $ff11\n    stx $14\n    lda $15\n    ldx $ff12\n    sta $ff12\n    stx $15\n    lda $16\n    ldx $ff13\n    sta $ff13\n    stx $16\n    lda $17\n    ldx $ff14\n    sta $ff14\n    stx $17\n    lda $18\n    ldx $ff15\n    sta $ff15\n    stx $18\n    lda $19\n    ldx $ff16\n    sta $ff16\n    stx $19\n    lda $1a\n    ldx $ff17\n    sta $ff17\n    stx $1a\n    lda $1b\n    ldx $ff18\n    sta $ff18\n    stx $1b\n    lda $1c\n    ldx $ff19\n    sta $ff19\n    stx $1c\n    lda $1d\n    ldx $ff1a\n    sta $ff1a\n    stx $1d\n    lda $1e\n    ldx $ff1b\n    sta $ff1b\n    stx $1e\n    lda $1f\n    ldx $ff1c\n    sta $ff1c\n    stx $1f\n    lda $20\n    ldx $ff1d\n    sta $ff1d\n    stx $20\n    lda $21\n    ldx $ff1e\n    sta $ff1e\n    stx $21\n    lda $22\n    ldx $ff1f\n    sta $ff1f\n    stx $22\n    lda $23\n    ldx $ff20\n    sta $ff20\n    stx $23\n    lda $24\n    ldx $ff21\n    sta $ff21\n    stx $24\n    lda $25\n    ldx $ff22\n    sta $ff22\n    stx $25\n    lda $26\n    ldx $ff23\n    sta $ff23\n    stx $26\n    lda $27\n    ldx $ff24\n    sta $ff24\n    stx $27\n    lda $28\n    ldx $ff25\n    sta $ff25\n    stx $28\n    lda $29\n    ldx $ff26\n    sta $ff26\n    stx $29\n    lda $2a\n    ldx $ff27\n    sta $ff27\n    stx $2a\n    lda $2b\n    ldx $ff28\n    sta $ff28\n    stx $2b\n    lda $2c\n    ldx $ff29\n    sta $ff29\n    stx $2c\n    lda $2d\n    ldx $ff2a\n    sta $ff2a\n    stx $2d\n    lda $2e\n    ldx $ff2b\n    sta $ff2b\n    stx $2e\n    rts\n\n; --- $853E: next course section (was lda $AC0D,y with y = section*2 [+1]) - now the\n;     NEXT_A \/ NEXT_B columns of the SH_ROAD map chains. Returns A = next section.\nNEXT_SECTION:\n    ldy $42                  ; current section\n    lda $4a\n    cmp #$13                 ; second half of the course picks the other branch\n    bcs NEXT_ALT\n    lda SH_ROAD_NEXT_A,y\n    rts\nNEXT_ALT:\n    lda SH_ROAD_NEXT_B,y\n    rts\n\n; --- $8591: A = A + the section's PALETTE column (was clc \/ adc $ACAA,y)\nPALETTE_ADD:\n    sta PAL_TMP\n    lda SH_ROAD_PALETTE,y\n    clc\n    adc PAL_TMP\n    rts\nPAL_TMP:\n    .byte $00\n\n; --- state\nMUS_REQ:\n    .byte $00\nMUS_ON:\n    .byte $00\nMUS_OWN:\nMUS_OWN0:\n    .byte $00\nMUS_OWN1:\n    .byte $00\nMUS_OWN2:\n    .byte $00\nMUS_BUSY0:\n    .byte $00\nMUS_BUSY1:\n    .byte $00\nMUS_BUSY2:\n    .byte $00\nMUS_FRL:\n    .byte $00\nMUS_FRH:\n    .byte $00\n"]],"binary_blob":""},{"x":3040.0,"y":280.0,"type":"MACRO_SID_SONG","custom_title":"","stable_uid":100301.0,"wire_in_source":-1.0,"wire_out_target":-1.0,"org_uid":-1.0,"show_only_used":false,"code_descriptor":"Code Block","scroll_alias":"","anim_alias":"","helper_text":"","comment_w_mult":1.0,"x_indent":0.0,"proxy":true,"collapsed":false,"end_address":63094.0,"pc_address":58084.0,"height":140.0,"title":"SID SONG","connected":true,"org_parent_x":3040.0,"org_parent_y":100.0,"has_org_parent":true,"code":[["macro_sid_song","SH_MUSIC",0.0,3.0,0.0,0.0,1.0]],"binary_blob":""},{"x":380.0,"y":440.0,"type":"COMMENT","custom_title":"","stable_uid":100003.0,"wire_in_source":-1.0,"wire_out_target":-1.0,"org_uid":-1.0,"show_only_used":false,"code_descriptor":"Code Block","scroll_alias":"","anim_alias":"","helper_text":"","comment_w_mult":3.0,"x_indent":0.0,"proxy":true,"collapsed":false,"end_address":0.0,"pc_address":0.0,"height":580.0,"title":"COMMENT","connected":false,"org_parent_x":-1.0,"org_parent_y":-1.0,"has_org_parent":false,"code":[["Comment","Editing the road: SH_ROAD tileset, one map per road segment (map n = segment n),\ndrawn the way it looks in the game (RAW ROWS UP). Press CHAINS in the tileset editor to\nsee and edit the course: each chain is a course section (SECTION 00-30) = a list of\nsegments, drawn bottom-up with their repeats. The game reads each list from its LAST\nentry (FEED LAST > FIRST), so the bottom map of a section is the last one in its list. Columns: NEXT_A \/ NEXT_B = the section that\nfollows (B in the second half of the game, $4A >= $13), PALETTE = the section's colour set.\nTABLES ON writes SH_ROAD_MAPLO\/HI\/ROWS\/REPS, _CHAINLO\/HI\/LEN, _NEXT_A\/B, _PALETTE and the\nsection lists at $F860 - the cart code reads those labels, so edits go straight into the game.\nMap addresses: segment 0 at $2980 (0-15 follow), 16 at $C000 (16-21), 22 at $F800 (22-24,\nunused spares), 25 at $6770 = the blank row sections 29 \/ 30 use. Keep $6540-$657F empty:\nit is sprite block $95, the blank sprite the HUD shows in place of every sprite.\nKeep $4D00 clear: maps 0-15 end at $4CFF. Colour sets: $ACC9 \/ $ACD2 \/ $ACDB (bg \/ MC1 \/ MC2).\nMoving sections (UP \/ DN in CHAINS) renumbers them and the NEXT_A \/ NEXT_B links follow,\nbut the cart code also checks sections 15, 27 and 28 by number ($855E \/ $8578 \/ $857E):\nkeep those three where they are."]],"binary_blob":""},{"x":1440.0,"y":620.0,"type":"MACRO_CODE","custom_title":"","stable_uid":100023.0,"wire_in_source":-1