diff --git a/C64DevMachine_win.yyp/scripts/scr_node_draw_macro_reu/scr_node_draw_macro_reu.gml b/C64DevMachine_win.yyp/scripts/scr_node_draw_macro_reu/scr_node_draw_macro_reu.gml
