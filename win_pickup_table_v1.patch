+                }
+                if (!_is) continue;
+                var _e = undefined;
+                for (var _k = 0; _k < array_length(_old); _k++) {
+                    if (real(_old[_k].x) == _x && real(_old[_k].y) == _y) { _e = _old[_k]; break; }
+                }
+                if (is_undefined(_e)) {
