+        for (var _r = 0; _r < _n; _r++) array_push(_out, (_ptr[_r] >> 8) & 0xFF);
+    }
+    for (var _r = 0; _r < _n; _r++) {
+        var _b = _lists[_r];
+        for (var _i = 0; _i < array_length(_b); _i++) array_push(_out, _b[_i]);
