+                    _vc.hold = 0;
+                    _vc.active = false;
+                    _vc.hr_cd = 0;
+                    _vc.cb = 0;
+                } else {
+                    _vc.vstop = true;
+                    _vc.cb = 0;
+                    _vc.active = false;
+                    _vc.hr_cd = 0;
