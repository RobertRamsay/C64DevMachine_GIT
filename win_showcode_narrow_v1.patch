         var _px = showcode_x;
         if (_px < 0) {
@@ -1107,7 +1116,7 @@ function scr_show_code_draw() {
         var _pad_b = SHOWCODE_PAD_B;
         var _grab  = SHOWCODE_GRAB;
 
