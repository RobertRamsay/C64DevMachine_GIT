                 } else if (showcode_resize == 2) {
-                    showcode_w = clamp(_mx - _px, 300, 900);
+                    showcode_w = clamp(_mx - _px, SHOWCODE_W_MIN, SHOWCODE_W_MAX);
                 } else {
