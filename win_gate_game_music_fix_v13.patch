00000.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_h": 0.0, "comment_w": 0.0, "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 0.0, "pc_address": 0.0, "height": 120.0, "title": "COMMENT", "connected": false, "org_parent_x": -1.0, "org_parent_y": -1.0, "has_org_parent": false, "code": [["Comment", "Begin at SYSTEM INIT.\nBank BASIC out so the\nlevel map is RAM.\nThen go to the title."]]}, {"binary_blob": "", "x": 2280.0, "y": 160.0, "type": "COMMENT", "params": [], "custom_title": "", "stable_uid": 300058.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_h": 0.0, "comment_w": 0.0, "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 0.0, "pc_address": 0.0, "height": 100.0, "title": "COMMENT", "connected": false, "org_parent_x": -1.0, "org_parent_y": -1.0, "has_org_parent": false, "code": [["Comment", "Every lamp right and\nno fuse blown = solved.\nElse retry the board."]]}, {"binary_blob": "", "x": 1960.0, "y": 160.0, "type": "COMMENT", "params": [], "custom_title": "", "stable_uid": 300055.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_h": 0.0, "comment_w": 0.0, "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 0.0, "pc_address": 0.0, "height": 100.0, "title": "COMMENT", "connected": false, "org_parent_x": -1.0, "org_parent_y": -1.0, "has_org_parent": false, "code": [["Comment", "Pulses spread one cell\nper step through wires\nand gates."]]}, {"binary_blob": "", "x": 1640.0, "y": 160.0, "type": "COMMENT", "params": [], "custom_title": "", "stable_uid": 300047.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_h": 0.0, "comment_w": 0.0, "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 0.0, "pc_address": 0.0, "height": 100.0, "title": "COMMENT", "connected": false, "org_parent_x": -1.0, "org_parent_y": -1.0, "has_org_parent": false, "code": [["Comment", "Once per frame: sync,\njoystick, cursor.\nFIRE sets / runs."]]}, {"binary_blob": "", "x": 680.0, "y": 160.0, "type": "COMMENT", "params": [], "custom_title": "", "stable_uid": 300003.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_h": 0.0, "comment_w": 0.0, "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 0.0, "pc_address": 0.0, "height": 100.0, "title": "COMMENT", "connected": false, "org_parent_x": -1.0, "org_parent_y": -1.0, "has_org_parent": false, "code": [["Comment", "MC bitmap front end.\nStart the music + SFX.\nFIRE starts level 1."]]}, {"binary_blob": "", "x": 1000.0, "y": 160.0, "type": "COMMENT", "params": [], "custom_title": "", "stable_uid": 300009.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_h": 0.0, "comment_w": 0.0, "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 0.0, "pc_address": 0.0, "height": 100.0, "title": "COMMENT", "connected": false, "org_parent_x": -1.0, "org_parent_y": -1.0, "has_org_parent": false, "code": [["Comment", "FrameTick: frame wait.\nIrqMusic: raster IRQ\nplays music + SFX."]]}, {"binary_blob": "", "x": 1320.0, "y": 160.0, "type": "COMMENT", "params": [], "custom_title": "", "stable_uid": 300040.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_h": 0.0, "comment_w": 0.0, "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 0.0, "pc_address": 0.0, "height": 120.0, "title": "COMMENT", "connected": false, "org_parent_x": -1.0, "org_parent_y": -1.0, "has_org_parent": false, "code": [["Comment", "Text mode + cyber font.\nCursor sprite.\nDraw board from the map."]]}, {"binary_blob": "", "x": 360.0, "y": 340.0, "type": "INIT", "params": [], "custom_title": "", "stable_uid": 300001.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_h": 0.0, "comment_w": 0.0, "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 2071.0, "pc_address": 2062.0, "height": 80.0, "title": "SYSTEM INIT", "connected": true, "org_parent_x": -1.0, "org_parent_y": -1.0, "has_org_parent": false, "code": [["sei", 0.0], ["lda_imm", 0.0], ["sta_abs", 53280.0], ["sta_abs", 53281.0]]}, {"binary_blob": "", "x": 2280.0, "y": 420.0, "type": "MACRO_CODE", "params": [], "custom_title": "", "stable_uid": 300060.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_h": 0.0, "comment_w": 0.0, "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 28840.0, "pc_address": 28672.0, "height": 100.0, "title": "CODE BLOCK", "connected": true, "org_parent_x": 2280.0, "org_parent_y": 340.0, "has_org_parent": true, "code": [["code_block", "; Names used in the comments of these blocks (all addresses are written\n; out in the code so nothing here claims memory):\n;   $0400 screen  $8000 GATE_LEVELS map  $A780 LEVEL_GATES  $C100 pulse state\n;   $A800 CLASS  $A900 MASK  $AA00 GTYPE  $AB00 COLOUR  $AC00-$B02F tables/texts\n;   ZP $50 PS (screen row) $52 PT (state row) $54/$56 row above, $58/$5A row\n;   below, $5C PC (colour row), $5E P1 (general pointer)\n;   $C000 LEVEL $C001 TICK $C002 CHANGED $C003 BLOWN $C004 CUR $C005 NACT\n;   $C006 DELAY $C007 FIREHELD $C008-$C00C REMAIN (AND OR NOT EOR NAND)\n;   $C00E VAL $C00F CM $C010 CK $C011 CH $C012 TMP $C013 FLASH\n;   $C014/$C015 input values $C016/$C017 input wired flags\n;   $C020 action list lo, $C048 hi, $C070 column, $C098 row\n\n; ---------------------------------------------------------------\n; JUDGE: every lamp must have been reached with the value it wants\n; and no fuse may have carried a 1.\n; ---------------------------------------------------------------\nJudge:\nLDA $C003\nBNE JFuse\nLDA #$02\nSTA $C00D\nJGRow:\nJSR SetRowPtrs\nLDY #$00\nJGCol:\nLDA ($50),Y\nTAX\nLDA $A800,X\nCMP #$04\nBCC JGNext\nCMP #$06\nBCS JGNext\nSEC                    ; 0 = wants 1, 1 = wants 0\nSBC #$04\nSTA $C012\nLDA ($52),Y\nBEQ JFail              ; never reached\nAND #$01\nEOR $C012\nBEQ JFail              ; wrong value\nJGNext:\nINY\nCPY #40\nBNE JGCol\nINC $C00D\nLDA $C00D\nCMP #25\nBNE JGRow\n; ---- solved ----\nLDA #$03\nJSR ShowMsg            ; \"CIRCUIT COMPLETE!\"\nJSR SndWin\nJSR WaitFire\nINC $C000\nLDA $C000\nCMP #10\nBCC JNextLevel\nLDA #$06\nJSR ShowMsg            ; \"ALL BOARDS SOLVED!\"\nJSR WaitFire\nLDA #$00               ; music interrupt off while the title restarts the tune\nSTA $D01A\nJMP Title\nJNextLevel:\nJMP StartLevel\nJFuse:\nLDA #$05\nJSR ShowMsg            ; \"FUSE BLOWN!\"\nJSR SndFuse\nJMP JFailWait\nJFail:\nLDA #$04\nJSR ShowMsg            ; \"WRONG OUTPUT!\"\nJSR SndFail\nJFailWait:\nJSR WaitFire\nJSR ResetBoard         ; keep the player's gates, clear the pulses\nLDA #$00\nJSR ShowMsg\nLDA #$01\nSTA $C007\nRTS\n\n; WaitFire: fire released, pressed, released (music keeps playing).\nWaitFire:\nJSR FrameTick\nLDA $DC00\nAND #$10\nBEQ WaitFire\nWFDown:\nJSR FrameTick\nLDA $DC00\nAND #$10\nBNE WFDown\nWFUp:\nJSR FrameTick\nLDA $DC00\nAND #$10\nBEQ WFUp\nRTS\n"]]}, {"binary_blob": "", "x": 1960.0, "y": 420.0, "type": "MACRO_CODE", "params": [], "custom_title": "", "stable_uid": 300057.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_h": 0.0, "comment_w": 0.0, "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 28607.0, "pc_address": 27936.0, "height": 100.0, "title": "CODE BLOCK", "connected": true, "org_parent_x": 1960.0, "org_parent_y": 340.0, "has_org_parent": true, "code": [["code_block", "; Names used in the comments of these blocks (all addresses are written\n; out in the code so nothing here claims memory):\n;   $0400 screen  $8000 GATE_LEVELS map  $A780 LEVEL_GATES  $C100 pulse state\n;   $A800 CLASS  $A900 MASK  $AA00 GTYPE  $AB00 COLOUR  $AC00-$B02F tables/texts\n;   ZP $50 PS (screen row) $52 PT (state row) $54/$56 row above, $58/$5A row\n;   below, $5C PC (colour row), $5E P1 (general pointer)\n;   $C000 LEVEL $C001 TICK $C002 CHANGED $C003 BLOWN $C004 CUR $C005 NACT\n;   $C006 DELAY $C007 FIREHELD $C008-$C00C REMAIN (AND OR NOT EOR NAND)\n;   $C00E VAL $C00F CM $C010 CK $C011 CH $C012 TMP $C013 FLASH\n;   $C014/$C015 input values $C016/$C017 input wired flags\n;   $C020 action list lo, $C048 hi, $C070 column, $C098 row\n\n; ---------------------------------------------------------------\n; PULSE SIMULATION\n; Every step looks at each cell that has no value yet:\n;   wire / lamp / fuse: takes the value of a connected neighbour that\n;     already had one before this step (its side must face this cell)\n;   gate: fires once its inputs (left and right wires) both have values;\n;     NOT uses whichever single input is wired.\n; A cell's state is (step*2)|value, so \"had a value before this step\"\n; is state<>0 and state/2 < TICK.  One step per 2 frames shows the\n; pulses travelling up the board.\n; ---------------------------------------------------------------\nRunCircuit:\nJSR ResetBoard\nLDA #$02\nJSR ShowMsg            ; \"PULSE RUNNING...\"\nLDA #$00\nSTA $D015              ; hide the cursor while it runs\nLDA #$02\nSTA $C001\nRCStep:\nLDA #$00\nSTA $C002\nJSR SimStep\nLDA $C002\nBEQ RCQuiet\nJSR SndTick            ; soft tick while pulses move\nRCQuiet:\nJSR FrameTick\nJSR FrameTick\nLDA $C002\nBEQ RCDone\nINC $C001\nLDA $C001\nCMP #120\nBCC RCStep\nRCDone:\nLDA #$01\nSTA $D015\nJMP Judge\n\n; ResetBoard: idle colours back, pulse state cleared, sources primed\n; as step 1 (state 3 = value 1, state 2 = value 0).\nResetBoard:\nLDA #$00\nSTA $C003\nLDA #$02\nSTA $C00D\nRBRow:\nJSR SetRowPtrs\nLDY #$00\nRBCol:\nLDA ($50),Y\nCMP #129               ; a pulse ball left on the board -> its trace\nBCC RBChar\nCMP #144\nBCS RBChar\nSBC #63                ; carry clear: ball -> wire\nSTA ($50),Y\nRBChar:\nTAX\nLDA $AB00,X\nSTA ($5C),Y\nLDA $A800,X\nCMP #$02\nBNE RBNot1\nLDA #$03\nJMP RBSet\nRBNot1:\nCMP #$03\nBNE RBNone\nLDA #$02\nJMP RBSet\nRBNone:\nLDA #$00\nRBSet:\nSTA ($52),Y\nINY\nCPY #40\nBNE RBCol\nINC $C00D\nLDA $C00D\nCMP #25\nBNE RBRow\nRTS\n\n; SeedSources: same as ResetBoard (used after a level is drawn).\nSeedSources:\nJMP ResetBoard\n\n; KnownBefore: A = a neighbour's state. Carry set + VAL = its value\n; when it had one before this step.\nKnownBefore:\nSTA $C012\nBEQ KBNo\nLSR\nCMP $C001\nBCS KBNo\nLDA $C012\nAND #$01\nSTA $C00E\nSEC\nRTS\nKBNo:\nCLC\nRTS\n\nSimStep:\nLDA #$02\nSTA $C00D\nSSRow:\nJSR SetRowPtrs\nLDY #$00\nSSCol:\nLDA ($52),Y\nBEQ SSOpen\n; already has a value: a pulse ball (chars 129-143) from an earlier step\n; turns back into its trace, coloured with the value it carries\nLDA ($50),Y\nCMP #129\nBCC SSNext\nCMP #144\nBCS SSNext\nSBC #63                ; carry clear here: 129-1-63 = 65 (ball -> wire)\nSTA ($50),Y\nLDA ($52),Y\nAND #$01\nBEQ SSBall0\nLDA #$0D\nJMP SSBallC\nSSBall0:\nLDA #$0B\nSSBallC:\nSTA ($5C),Y\nJMP SSNext\nSSOpen:\nLDA ($50),Y\nSTA $C011\nTAX\nLDA $A800,X\nSTA $C010\nCMP #$06\nBNE SSNotGate\nJMP GateCell\nSSNotGate:\nCMP #$01\nBEQ WireCell\nCMP #$04\nBEQ WireCell\nCMP #$05\nBEQ WireCell\nCMP #$08\nBEQ WireCell\nSSNext:\nINY\nCPY #40\nBNE SSCol\nINC $C00D\nLDA $C00D\nCMP #25\nBNE SSRow\nRTS\n\n; ---- wire, lamp or fuse cell ----\nWireCell:\nLDA $A900,X\nSTA $C00F\nAND #$01               ; joined upward?\nBEQ WCDown\nLDA ($54),Y\nTAX\nLDA $A900,X\nAND #$02               ; ...and the cell above joins down\nBEQ WCDown\nLDA ($56),Y\nJSR KnownBefore\nBCS WCSet\nWCDown:\nLDA $C00F\nAND #$02\nBEQ WCLeft\nLDA ($58),Y\nTAX\nLDA $A900,X\nAND #$01\nBEQ WCLeft\nLDA ($5A),Y\nJSR KnownBefore\nBCS WCSet\nWCLeft:\nLDA $C00F\nAND #$04\nBEQ WCRight\nDEY\nLDA ($50),Y\nTAX\nLDA $A900,X\nAND #$08\nBEQ WCLeftN\nLDA ($52),Y\nJSR KnownBefore\nINY\nBCS WCSet\nJMP WCRight\nWCLeftN:\nINY\nWCRight:\nLDA $C00F\nAND #$08\nBEQ WCNone\nINY\nLDA ($50),Y\nTAX\nLDA $A900,X\nAND #$04\nBEQ WCRightN\nLDA ($52),Y\nJSR KnownBefore\nDEY\nBCS WCSet\nJMP WCNone\nWCRightN:\nDEY\nWCNone:\nJMP SSNext\n\nWCSet:\nJSR StoreVal           ; state + \"changed\"\nLDA $C010\nCMP #$08\nBEQ WCFuse\nCMP #$04\nBCS WCLamp             ; 4 or 5\nLDA $C011                 ; plain wire piece (65-79)? show the pulse ball\nCMP #65\nBCC WCPlain\nCMP #80\nBCS WCPlain\nADC #64                ; carry clear: wire -> ball char (129-143)\nSTA ($50),Y\nLDA #$01               ; white ball\nJMP WCCol\nWCPlain:\nLDA $C00E                ; switch: light green = 1, dark grey = 0\nBEQ WCZero\nLDA #$0D\nJMP WCCol\nWCZero:\nLDA #$0B\nWCCol:\nSTA ($5C),Y\nJMP SSNext\nWCLamp:\n; lamp 4 wants 1, lamp 5 wants 0: white when right, red when wrong\nSEC\nSBC #$04               ; 0 = wants 1, 1 = wants 0\nEOR $C00E                ; 1 when right\nBEQ WCLampBad\nLDA #$01\nJMP WCCol\nWCLampBad:\nLDA #$02\nJMP WCCol\nWCFuse:\nLDA $C00E\nBEQ WCZero\nLDA #$01\nSTA $C003\nLDA #$02\nJMP WCCol\n\nStoreVal:\nLDA $C001\nASL\nORA $C00E\nSTA ($52),Y\nLDA #$01\nSTA $C002\nRTS\n\n; ---- gate cell (centre of a 3-cell [AND] label): inputs are the wires\n; two cells to its left and right ----\nGateCell:\nLDA $AA00,X\nSTA $C00F                 ; CM = gate type here\nLDA #$00\nSTA $C016\nSTA $C017\nDEY                    ; left input (2 cells left, past the \"[\" side char)\nDEY\nLDA ($50),Y\nTAX\nLDA $A900,X\nAND #$08\nBEQ GCNoA\nLDA #$01\nSTA $C016\nLDA ($52),Y\nJSR KnownBefore\nBCC GCNoA\nLDA $C00E\nSTA $C014\nLDA #$02\nSTA $C016               ; 2 = wired and has a value\nGCNoA:\nINY\nINY\nINY\nINY                    ; right input (2 cells right): joined to the left?\nLDA ($50),Y\nTAX\nLDA $A900,X\nAND #$04\nBEQ GCNoB\nLDA #$01\nSTA $C017\nLDA ($52),Y\nJSR KnownBefore\nBCC GCNoB\nLDA $C00E\nSTA $C015\nLDA #$02\nSTA $C017\nGCNoB:\nDEY\nDEY\nLDA $C00F\nCMP #$02\nBNE GCTwo\n; NOT: the left input if wired, otherwise the right one\nLDA $C016\nBEQ GCNotB\nCMP #$02\nBNE GCWait\nLDA $C014\nJMP GCInvert\nGCNotB:\nLDA $C017\nCMP #$02\nBNE GCWait\nLDA $C015\nGCInvert:\nEOR #$01\nJMP GCOut\nGCTwo:\nLDA $C016\nCMP #$02\nBNE GCWait\nLDA $C017\nCMP #$02\nBNE GCWait\nLDA $C00F\nBEQ GCAnd\nCMP #$01\nBEQ GCOr\nCMP #$03\nBEQ GCEor\nLDA $C014               ; NAND\nAND $C015\nEOR #$01\nJMP GCOut\nGCAnd:\nLDA $C014\nAND $C015\nJMP GCOut\nGCOr:\nLDA $C014\nORA $C015\nJMP GCOut\nGCEor:\nLDA $C014\nEOR $C015\nGCOut:\nSTA $C00E\nJSR StoreVal           ; the label keeps its colour - the result shows on\nGCWait:                ; the wire leaving the top of the gate\nJMP SSNext\n"]]}, {"binary_blob": "", "x": 1640.0, "y": 420.0, "type": "LABEL", "params": [], "custom_title": "", "stable_uid": 300049.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_h": 0.0, "comment_w": 0.0, "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 27392.0, "pc_address": 27392.0, "height": 40.0, "title": "ADDRESS LABEL", "connected": true, "org_parent_x": 1640.0, "org_parent_y": 340.0, "has_org_parent": true, "code": [["label", "GameLoop"]]}, {"binary_blob": "", "x": 360.0, "y": 420.0, "type": "MACRO_CODE", "params": [], "custom_title": "", "stable_uid": 300002.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_h": 0.0, "comment_w": 0.0, "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 2097.0, "pc_address": 2071.0, "height": 100.0, "title": "CODE BLOCK", "connected": true, "org_parent_x": -1.0, "org_parent_y": -1.0, "has_org_parent": false, "code": [["code_block", "; Names used in the comments of these blocks (all addresses are written\n; out in the code so nothing here claims memory):\n;   $0400 screen  $8000 GATE_LEVELS map  $A780 LEVEL_GATES  $C100 pulse state\n;   $A800 CLASS  $A900 MASK  $AA00 GTYPE  $AB00 COLOUR  $AC00-$B02F tables/texts\n;   ZP $50 PS (screen row) $52 PT (state row) $54/$56 row above, $58/$5A row\n;   below, $5C PC (colour row), $5E P1 (general pointer)\n;   $C000 LEVEL $C001 TICK $C002 CHANGED $C003 BLOWN $C004 CUR $C005 NACT\n;   $C006 DELAY $C007 FIREHELD $C008-$C00C REMAIN (AND OR NOT EOR NAND)\n;   $C00E VAL $C00F CM $C010 CK $C011 CH $C012 TMP $C013 FLASH\n;   $C014/$C015 input values $C016/$C017 input wired flags\n;   $C020 action list lo, $C048 hi, $C070 column, $C098 row\n\n; ---------------------------------------------------------------\n; BOOT  - runs once after SYSTEM INIT\n; Bank BASIC out ($01=$36) so the level map under $A000-$BFFF is RAM,\n; then go to the title screen.\n; ---------------------------------------------------------------\nLDA #$36\nSTA $01\n; Switch the CIA timer interrupts off. BITMAP and VIC nodes end with CLI;\n; with the CIAs quiet that CLI can't let the KERNAL IRQ in (it would scan\n; the keyboard through $DC00 - the joystick port - and blink a cursor).\nLDA #$7F\nSTA $DC0D\nSTA $DD0D\nLDA $DC0D              ; clear anything already pending\nLDA $DD0D\nLDA #$00\nSTA $C000\nJMP Title\n"]]}, {"binary_blob": "", "x": 1320.0, "y": 420.0, "type": "LABEL", "params": [], "custom_title": "", "stable_uid": 300042.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_h": 0.0, "comment_w": 0.0, "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 26624.0, "pc_address": 26624.0, "height": 40.0, "title": "ADDRESS LABEL", "connected": true, "org_parent_x": 1320.0, "org_parent_y": 340.0, "has_org_parent": true, "code": [["label", "StartLevel"]]}, {"binary_blob": "", "x": 680.0, "y": 420.0, "type": "LABEL", "params": [], "custom_title": "", "stable_uid": 300005.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_h": 0.0, "comment_w": 0.0, "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 2304.0, "pc_address": 2304.0, "height": 40.0, "title": "ADDRESS LABEL", "connected": true, "org_parent_x": 680.0, "org_parent_y": 340.0, "has_org_parent": true, "code": [["label", "Title"]]}, {"binary_blob": "", "x": 1000.0, "y": 420.0, "type": "LABEL", "params": [], "custom_title": "", "stable_uid": 300011.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_h": 0.0, "comment_w": 0.0, "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 9728.0, "pc_address": 9728.0, "height": 40.0, "title": "ADDRESS LABEL", "connected": true, "org_parent_x": 1000.0, "org_parent_y": 34