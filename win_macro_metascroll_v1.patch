diff --git a/C64DevMachine_win.yyp/scripts/scr_node_step_macro_metascroll/scr_node_step_macro_metascroll.gml b/C64DevMachine_win.yyp/scripts/scr_node_step_macro_metascroll/scr_node_step_macro_metascroll.gml
new file mode 100644
index 0000000..c9aaca5
