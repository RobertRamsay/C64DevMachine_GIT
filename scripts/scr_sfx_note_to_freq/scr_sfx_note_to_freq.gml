function scr_sfx_note_to_freq(_semitone) {
    // PAL SID frequency table — 96 notes, C#0 to B-7
    // Each entry = round(semitone_freq * 16777216 / 985248)
    var _table = [
        // Octave 0: C#0-B0
        0x0117, 0x0127, 0x0139, 0x014B, 0x015F, 0x0174,
        0x018B, 0x01A3, 0x01BC, 0x01D7, 0x01F3, 0x0211,
        // Octave 1: C#1-B1
        0x022E, 0x024E, 0x0271, 0x0296, 0x02BE, 0x02E8,
        0x0316, 0x0346, 0x0379, 0x03AF, 0x03E7, 0x0422,
        // Octave 2: C#2-B2
        0x045C, 0x049C, 0x04E2, 0x052C, 0x057C, 0x05CF,
        0x062C, 0x068C, 0x06F2, 0x075E, 0x07CE, 0x0845,
        // Octave 3: C#3-B3
        0x08B8, 0x0939, 0x09C4, 0x0A58, 0x0AF7, 0x0BA2,
        0x0C58, 0x0D18, 0x0DE4, 0x0EBC, 0x0F9C, 0x108A,
        // Octave 4: C#4-B4
        0x1170, 0x1271, 0x1388, 0x14B0, 0x15EF, 0x1744,
        0x18B0, 0x1A30, 0x1BC8, 0x1D78, 0x1F38, 0x2114,
        // Octave 5: C#5-B5
        0x22E0, 0x24E2, 0x2710, 0x2960, 0x2BDE, 0x2E88,
        0x3160, 0x3460, 0x3790, 0x3AF0, 0x3E70, 0x4228,
        // Octave 6: C#6-B6
        0x45C0, 0x49C4, 0x4E20, 0x52C0, 0x57BC, 0x5D10,
        0x62C0, 0x68C0, 0x6F20, 0x75E0, 0x7CE0, 0x8450,
        // Octave 7: C#7-B7
        0x8B80, 0x9388, 0x9C40, 0xA580, 0xAF78, 0xBA20,
        0xC580, 0xD180, 0xDE40, 0xEBC0, 0xF9C0, 0xFFFF
    ];
    _semitone = clamp(_semitone, 0, array_length(_table) - 1);
    return _table[_semitone];
}