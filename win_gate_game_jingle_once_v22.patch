true, "code": [["macro_bmp", "FRONT_END", 16384.0, 1.0, 0.0]]}, {"binary_blob": "", "x": 680.0, "y": 1080.0, "type": "MACRO_CODE", "params": [], "custom_title": "", "stable_uid": 301064.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_h": 0.0, "comment_w": 0.0, "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 9461.0, "pc_address": 9392.0, "height": 100.0, "title": "CODE BLOCK", "connected": true, "org_parent_x": 680.0, "org_parent_y": 340.0, "has_org_parent": true, "code": [["code_block", "; Names used in the comments of these blocks (all addresses are written\n; out in the code so nothing here claims memory):\n;   $0400 screen  $8000 GATE_LEVELS map (RLE ROOMS, 20 boards)  $A780 LEVEL_GATES  $C100 pulse state\n;   $A800 CLASS  $A900 MASK  $AA00 GTYPE  $AB00 COLOUR  $AC00-$B217 tables/texts\n;   ZP $50 PS (screen row) $52 PT (state row) $54/$56 row above, $58/$5A row\n;   below, $5C PC (colour row), $5E P1 (general pointer)\n;   $C000 LEVEL $C001 TICK $C002 CHANGED $C003 BLOWN $C004 CUR $C005 NACT\n;   $C006 DELAY $C007 FIREHELD $C008-$C00C REMAIN (AND OR NOT EOR NAND)\n;   $C00E VAL $C00F CM $C010 CK $C011 CH $C012 TMP $C013 FLASH\n;   $C014/$C015 input values $C016/$C017 input wired flags\n;   $C020 action list lo, $C048 hi, $C070 column, $C098 row\n\n; ---------------------------------------------------------------\n; TITLE CYCLE: the picture for 4 seconds, then HOW TO PLAY for 12 seconds,\n; then the picture again (TitlePic re-draws it). FIRE on either starts.\n; M toggles the music on both.\n; ---------------------------------------------------------------\nTitleHold:\nLDA #$00\nSTA $D015              ; no sprites on the title screens\nSTA $C0E8             ; back to the user's music setting\nSTA $C0E9\n; Cooldown: the FIRE that left the game-over / end screen must not start a\n; new game. Wait for it to be let go, then ignore fire for 1 second.\nTHRelease:\nJSR FrameTick\nLDA $DC00\nAND #$10\nBEQ THRelease\nLDA #$32               ; 50 frames = 1 second\nSTA $C019\nLDA #$00\nSTA $C01A\nTHCool:\nJSR FrameTick\nJSR CheckM\nJSR TickTimer\nBNE THCool\nLDA #$C8               ; picture: 200 frames = 4 seconds\nSTA $C019\nLDA #$00\nSTA $C01A\nTHLoop:\nJSR FrameTick\nJSR CheckM\nLDA $DC00\nAND #$10\nBEQ TitleGo            ; fire\nJSR TickTimer\nBNE THLoop\nJSR ShowKey            ; HOW TO PLAY\nLDA #$58               ; 600 frames = 12 seconds\nSTA $C019\nLDA #$02\nSTA $C01A\nKYLoop:\nJSR FrameTick\nJSR CheckM\nJSR DrawMusicState\nLDA $DC00\nAND #$10\nBEQ TitleGo\nJSR TickTimer\nBNE KYLoop\nJMP TitlePic           ; back to the picture (the 1 s cooldown runs again)\nTitleGo:\nJSR FrameTick          ; wait for fire to be let go\nLDA $DC00\nAND #$10\nBEQ TitleGo\nJMP StartLevel\n"]]}, {"binary_blob": "", "x": 2280.0, "y": 620.0, "type": "MACRO_CODE", "params": [], "custom_title": "", "stable_uid": 301065.0, "wire_in_source": -1.0, "wire_out_target": -1.0, "org_uid": -1.0, "show_only_used": false, "code_descriptor": "", "scroll_alias": "", "anim_alias": "", "helper_text": "", "comment_h": 0.0, "comment_w": 0.0, "comment_w_mult": 1.0, "x_indent": 0.0, "proxy": true, "collapsed": false, "end_address": 29026.0, "pc_address": 28854.0, "height": 100.0, "title": "CODE BLOCK", "connected": true, "org_parent_x": 2280.0, "org_parent_y": 340.0, "has_org_parent": true, "code": [["code_block", "; Names used in the comments of these blocks (all addresses are written\n; out in the code so nothing here claims memory):\n;   $0400 screen  $8000 GATE_LEVELS map (RLE ROOMS, 20 boards)  $A780 LEVEL_GATES  $C100 pulse state\n;   $A800 CLASS  $A900 MASK  $AA00 GTYPE  $AB00 COLOUR  $AC00-$B217 tables/texts\n;   ZP $50 PS (screen row) $52 PT (state row) $54/$56 row above, $58/$5A row\n;   below, $5C PC (colour row), $5E P1 (general pointer)\n;   $C000 LEVEL $C001 TICK $C002 CHANGED $C003 BLOWN $C004 CUR $C005 NACT\n;   $C006 DELAY $C007 FIREHELD $C008-$C00C REMAIN (AND OR NOT EOR NAND)\n;   $C00E VAL $C00F CM $C010 CK $C011 CH $C012 TMP $C013 FLASH\n;   $C014/$C015 input values $C016/$C017 input wired flags\n;   $C020 action list lo, $C048 hi, $C070 column, $C098 row\n\n; ---------------------------------------------------------------\n; SCREENS: HOW TO PLAY (room 20 of GATE_LEVELS) and the end screen\n; (room 21), plus the M key and a frame timer. Edit both screens in the\n; map editor like a board.\n; ---------------------------------------------------------------\n; TickTimer: TIMERLO/HI - 1. Z set when it reaches 0.\nTickTimer:\nLDA $C019\nBNE TTLow\nDEC $C01A\nTTLow:\nDEC $C019\nLDA $C019\nORA $C01A\nRTS\n\n; CheckM: M key toggles the music. Keyboard column 4 ($DC00 bit 4 low),\n; M is row 4 ($DC01 bit 4). $DC00 goes back to $FF for the joystick.\nCheckM:\nLDA #$EF\nSTA $DC00\nLDA $DC01\nLDX #$FF\nSTX $DC00\nAND #$10\nBNE CMUp               ; M not down\nLDA $C01E\nBNE CMDone             ; still held from last frame\nLDA #$01\nSTA $C01E\nLDA $C01D\nEOR #$01\nSTA $C01D\nBNE CMDone\nLDA #$00               ; music off: silence voices 1 and 2 now\nSTA $D404\nSTA $D40B\nCMDone:\nRTS\nCMUp:\nLDA #$00\nSTA $C01E\nRTS\n\n; DrawMusicState: ON / OFF after \"M: MUSIC\" on the HOW TO PLAY screen.\nDrawMusicState:\nLDA $C01D\nBEQ DMSOff\nLDA #15                ; O\nSTA $07DF\nLDA #14                ; N\nSTA $07E0\nLDA #32\nSTA $07E1\nRTS\nDMSOff:\nLDA #15                ; O\nSTA $07DF\nLDA #6                 ; F\nSTA $07E0\nSTA $07E1\nRTS\n\n; TextMode: VIC bank 0, screen $0400, font $3000, black.\nTextMode:\nLDA $DD00\nAND #$FC\nORA #$03\nSTA $DD00\nLDA #$1C\nSTA $D018\nLDA #$1B\nSTA $D011\nLDA #$C8\nSTA $D016\nLDA #$00\nSTA $D020\nSTA $D021\nSTA $D015\nRTS\n\n; DrawRoom: A = room number. Unpacks that RLE room onto the screen with\n; the idle colours (no pulse state, no cursor list - see DrawLevel).\nDrawRoom:\nASL\nTAX\nLDA $8000,X\nSTA $5E\nLDA $8001,X\nSTA $5F\nLDA #$00\nSTA $C00D\nDRBand:\nJSR GetByte\nSTA $C01B\nLDX #$00\nDRRun:\nJSR GetByte\nSTA $C01C\nJSR GetByte\nDRFill:\nSTA $C0C0,X\nINX\nDEC $C01C\nBNE DRFill\nCPX #40\nBCC DRRun\nDREmit:\nJSR SetRowPtrs\nLDY #$00\nDRCol:\nLDA $C0C0,Y\nSTA ($50),Y\nTAX\nLDA $AB00,X\nSTA ($5C),Y\nINY\nCPY #40\nBNE DRCol\nINC $C00D\nLDA $C00D\nCMP #25\nBEQ DRDone\nDEC $C01B\nBNE DREmit\nJMP DRBand\nDRDone:\nRTS\n\n; ShowKey: the HOW TO PLAY screen (title row yellow, bottom row white).\nShowKey:\nJSR TextMode\nLDA #20\nJSR DrawRoom\nLDY #39\nSKCol:\nLDA #$07\nSTA $D828,Y            ; row 1 (HOW TO PLAY)\nLDA #$01\nSTA $DBC0,Y            ; row 24 (FIRE / M)\nDEY\nBPL SKCol\nJMP DrawMusicState\n\n; EndScreen: all 20 boards solved. Lives lost, then FIRE or 15 seconds\n; back to the title.\nEndScreen:\nJSR TextMode\nLDA #21\nJSR DrawRoom\nLDY #39\nESCol:\nLDA #$07\nSTA $D918,Y            ; row 7 (CONGRATULATIONS!) yellow\nLDA #$01\nSTA $DAA8,Y            ; row 17 (PRESS FIRE...) white\nDEY\nBPL ESCol\nLDA #$05               ; lives lost = 5 - lives left\nSEC\nSBC $C018\nORA #$30\nSTA $0621\nLDA #$EE               ; 750 frames = 15 seconds\nSTA $C019\nLDA #$02\nSTA $C01A\nESRelease:\nJSR FrameTick          ; let go of fire first\nLDA $DC00\nAND #$10\nBEQ ESRelease\nESWait:\nJSR FrameTick\nJSR EndFx              ; diagonal colour sweep over the text and lamps\nJSR CheckM\nLDA $DC00\nAND #$10\nBEQ ESDone\nJSR TickTimer\nBNE ESWait\nESDone:\nLDA #$00               ; music interrupt off while the title restarts the tune\nSTA $D01A\nJMP Title\n\n; EndFx: diagonal colour sweep. Each cell of the rows in FXROWS takes\n; FXCOLS[(column + row*2 - time) & 15], so bands of colour slide\n; diagonally across the text. 8 rows x 40 cells, well inside a frame.\nEndFx:\nINC $C01F\nLDX #$00\nEFRow:\nSTX $C012\nLDA $B220,X           ; row number\nSTA $C00D\nJSR SetRowPtrs         ; PC = this row's colour RAM\nLDA $C00D\nASL                    ; row*2 tilts the bands\nSEC\nSBC $C01F             ; - tim