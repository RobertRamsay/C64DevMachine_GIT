@@ -185,7 +185,7 @@ if (height_dirty) {
     case "NEW_STR":     height = _G * 4;  break;         // 100
     case "MACRO_JOY":   height = _G * 6;  break;
     case "MACRO_LETTERS":   height = _G * 6;  break;   // 26 keys, 6 across = 5 rows
