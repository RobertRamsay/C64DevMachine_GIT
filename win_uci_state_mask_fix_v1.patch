diff --git a/C64DevMachine_win.yyp/scripts/scr_compile_macro_uci_reu/scr_compile_macro_uci_reu.gml b/C64DevMachine_win.yyp/scripts/scr_compile_macro_uci_reu/scr_compile_macro_uci_reu.gml
