diff --git a/C64DevMachine_win.yyp/scripts/scr_sound_editor_wave_menu/scr_sound_editor_wave_menu.gml b/C64DevMachine_win.yyp/scripts/scr_sound_editor_wave_menu/scr_sound_editor_wave_menu.gml
